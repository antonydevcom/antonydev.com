---
import Container from '@/components/ui/Container.astro';
import ContactForm from '@/components/ui/ContactForm.astro';
import WhatsAppIcon from '@/components/ui/WhatsAppIcon.astro';
import { getWhatsAppLink } from '@/lib/whatsapp';
import { SectionReveal } from '@/components/motion/SectionReveal';
import { SectionHeaderReveal } from '@/components/motion/SectionHeaderReveal';

const waLink = getWhatsAppLink('contacto');
---

<section class="contact" id="contacto" aria-labelledby="contact-heading">
  <Container>
    <div class="contact-grid">

      <!-- ── Left — info ─────────────────────────── -->
      <div class="contact-info">
        <SectionHeaderReveal
          eyebrow="Contacto"
          heading={"Cuéntame sobre\ntu proyecto"}
          headingId="contact-heading"
          headingPer="line"
          showDivider={false}
          client:visible
        />
        <p class="contact-lead">
          Usa el formulario o escríbeme por WhatsApp. No necesito un brief elaborado:
          solo cuéntame qué tiene tu negocio y qué le falta.
        </p>

        <!-- WhatsApp CTA — primary channel -->
        <a href={waLink} target="_blank" rel="noopener noreferrer" class="wa-cta">
          <WhatsAppIcon size={22} />
          <span>
            <strong>Escríbeme por WhatsApp</strong>
            <em>Respuesta inmediata</em>
          </span>
        </a>

        <div class="divider-or" aria-hidden="true"><span>o por correo</span></div>

        <ul class="info-list" role="list">
          <li>
            <a href="mailto:hola@antonydev.com" class="info-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="20" height="16" x="2" y="4" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
              <span class="info-label">hola@antonydev.com</span>
            </a>
          </li>
          <li>
            <span class="info-item info-location">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <span class="info-label">Zihuatanejo, Guerrero, México</span>
            </span>
          </li>
        </ul>
      </div>

      <!-- ── Right — form ────────────────────────── -->
      <SectionReveal client:visible delay={0.12}>
      <div class="contact-form-wrap">
        <ContactForm />
      </div>
      </SectionReveal>

    </div>
  </Container>
</section>

<style>
  .contact {
    position: relative;
    z-index: 1;
    background-color: var(--bg-page);
    padding-top: clamp(4.5rem, 10vw, 7rem);
    padding-bottom: clamp(4.5rem, 10vw, 7rem);
    border-bottom: 1px solid var(--border);
  }

  @media (min-width: 768px) {
    .contact {
      margin-top: -2rem;
      padding-top: calc(9rem + 2rem);
      padding-bottom: 9rem;
      background-color: rgba(238, 232, 223, 0.55);
      -webkit-backdrop-filter: var(--glass-section);
      backdrop-filter: var(--glass-section);
      border-bottom-color: rgba(42, 32, 27, 0.1);
    }
  }

  @supports not ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
    @media (min-width: 768px) {
      .contact {
        margin-top: 0;
        padding-top: 9rem;
        background-color: var(--bg-page);
        border-bottom-color: var(--border);
      }
    }
  }

  /* ── Two-column split ────────────────────────────── */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(var(--space-12), 5vw, var(--space-16));
    align-items: start;
  }

  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-24);
    }
  }

  .contact-lead {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.75;
    color: rgba(42, 32, 27, 0.72);
    margin: 0 0 var(--space-8) 0;
    max-width: 38ch;
  }

  /* ── WhatsApp CTA ─────────────────────────────────── */
  .wa-cta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    background-color: var(--color-cafe);
    color: var(--text-inverse);
    border-radius: var(--radius-button);
    padding: var(--space-4) var(--space-6);
    text-decoration: none;
    margin-bottom: var(--space-8);
    transition:
      background-color var(--dur-base) var(--ease-out),
      box-shadow       var(--dur-slow) var(--ease-out),
      transform        var(--dur-fast) var(--ease-out);
    max-width: fit-content;
  }

  @media (max-width: 640px) {
    .wa-cta {
      max-width: 100%;
      width: 100%;
    }
  }

  .wa-cta svg {
    flex-shrink: 0;
    transition: transform var(--dur-base) var(--ease-out) 40ms;
  }

  .wa-cta:hover {
    background-color: var(--color-cafe-negro);
    box-shadow: var(--shadow-button);
    transform: translateY(-2px);
  }

  .wa-cta:hover svg {
    transform: translateY(-1px) scale(1.06);
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-cta:hover,
    .wa-cta:hover svg { transform: none; }
  }

  .wa-cta span {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .wa-cta strong {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .wa-cta em {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-style: normal;
    opacity: 0.72;
  }

  /* ── Divider ─────────────────────────────────────── */
  .divider-or {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .divider-or::before,
  .divider-or::after {
    content: '';
    flex: 1;
    height: 1px;
    background-color: var(--border);
  }

  .divider-or span {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: rgba(42, 32, 27, 0.42);
    white-space: nowrap;
  }

  /* ── Info list ───────────────────────────────────── */
  .info-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: 0;
    margin: 0;
  }

  .info-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--text-primary);
    transition:
      color     var(--dur-fast)   var(--ease-out),
      transform var(--dur-base)   var(--ease-premium),
      gap       var(--dur-base)   var(--ease-out);
  }

  a.info-item:hover {
    color: var(--color-cafe-negro);
    transform: translateX(4px);
    gap: calc(var(--space-3) + 2px);
  }

  @media (prefers-reduced-motion: reduce) {
    a.info-item:hover { transform: none; gap: var(--space-3); }
  }

  .info-label {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: rgba(42, 32, 27, 0.82);
  }

  /* ── Right — form ─────────────────────────────────── */
  .contact-form-wrap {
    background-color: transparent;
  }
</style>

<style is:global>
  /* ── Contact section header — per-section overrides ─── */

  .contact .section-header {
    margin: 0;
  }

  .contact .eyebrow {
    margin-bottom: var(--space-4);
  }

  .contact .section-header h2 {
    font-size: clamp(2rem, 3.5vw, 2.875rem);
    letter-spacing: -0.025em;
    margin: 0 0 var(--space-6) 0;
  }
</style>
