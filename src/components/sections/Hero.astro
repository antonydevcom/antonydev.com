---
import Button from '@/components/ui/Button.astro';
import WhatsAppIcon from '@/components/ui/WhatsAppIcon.astro';
import { getWhatsAppLink } from '@/lib/whatsapp';
import { HeroHeading } from '@/components/motion/HeroHeading';
import { HeroLogoMotion } from '@/components/motion/HeroLogoMotion';

const waLink = getWhatsAppLink('hero');
---

<section class="hero" id="inicio" aria-label="Presentación principal">

  <!-- z:0 — Atmospheric background image, absolutely covers the section -->
  <div class="hero-bg" aria-hidden="true">
    <img
      src="/images/branding/hero.png"
      alt=""
      width="1080"
      height="1440"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      class="hero-bg-img"
    />
  </div>

  <!-- z:1 — Warm ivory wash over the image -->
  <div class="hero-overlay" aria-hidden="true"></div>

  <!-- z:2 — Centered editorial content -->
  <div class="hero-stage">

    <HeroLogoMotion client:load />

    <p class="hero-kicker"><span class="hero-kicker-item">Desarrollo web</span><span class="hero-kicker-sep" aria-hidden="true"></span><span class="hero-kicker-item">Diseño</span><span class="hero-kicker-sep" aria-hidden="true"></span><span class="hero-kicker-item">Sistemas</span></p>

    <HeroHeading text="Antonio Valdovinos" className="hero-heading" client:load />
    <p class="hero-role">Fullstack web developer</p>

    <div class="hero-rule" aria-hidden="true"></div>

    <p class="hero-body">
      Creo sitios web, sistemas a medida e identidades digitales para
      negocios en Zihuatanejo e Ixtapa que necesitan algo que funcione de verdad.
    </p>

    <div class="cta-group">
      <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-wa" data-cursor="premium">
        <WhatsAppIcon />
        Auditoría gratuita
      </a>
      <Button href="/#servicios" variant="secondary" size="lg" class="hero-cta">
        Ver servicios&nbsp;→
      </Button>
    </div>

  </div>

  <!-- z:4 — Scroll indicator -->
  <a href="#servicios" class="hero-scroll" aria-label="Ver servicios">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 5v14M5 12l7 7 7-7"/>
    </svg>
  </a>

</section>

<style>
  /* ══════════════════════════════════════════════════
   * HERO — Full-bleed layered cinematic composition.
   * isolation: isolate creates a self-contained stacking
   * context so z-indexes here never conflict with the navbar.
   * ══════════════════════════════════════════════════ */

  .hero {
    position: relative;
    isolation: isolate;        /* own stacking context */
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: var(--color-marfil);
    margin-top: -1px;
    border-bottom: 1px solid rgba(42, 32, 27, 0.045);
  }

  :global(body.page-home) .hero {
    margin-top: 0;
    /* Fill dynamic viewport (mobile URL bar) so no marfil strip under the photo */
    min-height: 100svh;
    min-height: 100dvh;
  }

  /* ── Layer 0: Background image ──────────────────────
   * Absolutely covers the full section.
   * Explicit top/right/bottom/left instead of inset shorthand
   * avoids any browser quirk with the shorthand in flex contexts.
   */
  .hero-bg {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 0;
    /* Explicit dimensions in case % doesn't resolve through flex */
    width: 100%;
    height: 100%;
  }

  /*
   * Image fills the bg container.
   * !important on width/height beats the Tailwind base reset
   * (img { height: auto }) which lives in @layer base.
   * scale(1.04) pushes the blurred edges outside overflow:hidden.
   */
  .hero-bg-img {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    object-fit: cover;
    object-position: 60% 38%;
    transform: scale(1.04);
    filter: blur(0.4px) saturate(0.92) brightness(1.0) contrast(0.98) sepia(0);
    animation: hero-bg-in 2200ms var(--ease-premium) 0ms both;
  }

  /* ── Layer 1: Warm overlay ───────────────────────── */
  .hero-overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    /* Dark warm instead of ivory fog — preserves image colors and depth */
    background: rgba(30, 23, 19, 0.14);
    pointer-events: none;
  }

  /* ── Layer 2: Centered editorial stage ───────────── */

  /*
   * Radial warm halo behind the content block — barely visible (9% opacity).
   * Creates a sensation of depth: content floats above the image rather than
   * sitting flat on it. "Felt not noticed."
   */
  .hero-stage::before {
    content: '';
    position: absolute;
    inset: -14% -8%;
    z-index: -1;
    background: radial-gradient(
      ellipse 75% 65% at 50% 44%,
      rgba(247, 244, 238, 0.09) 0%,
      transparent 68%
    );
    pointer-events: none;
  }

  .hero-stage {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 52rem;
    padding-inline: clamp(1.5rem, 6vw, 4rem);
    padding-top: clamp(3.5rem, 10vh, 7rem);
    padding-bottom: clamp(4.5rem, 12vh, 8rem);
  }

  /* ── Hero logo (Motion island) — size + blend; motion handles entrance + float ─ */
  :global(.hero-logo-motion-root) {
    margin-bottom: clamp(1.35rem, 2.75vw, 2.15rem);
    display: flex;
    justify-content: center;
    width: 100%;
  }

  :global(.hero-logo-motion-root .hero-logo) {
    display: block !important;
    height: clamp(104px, 12.5vw, 172px) !important;
    width: auto !important;
    max-width: none !important;
    mix-blend-mode: multiply;
  }

  /* ── Kicker — small label rail ───────────────────── */
  .hero-kicker {
    font-family: var(--font-body);
    font-size: 0.6rem;
    font-weight: 400;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(42, 32, 27, 0.50);
    margin: 0 0 clamp(0.75rem, 1.5vw, 1rem);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65em;
    flex-wrap: wrap;
    animation: hero-up 900ms var(--ease-premium) 360ms both;
  }

  .hero-kicker-sep {
    width: 1px;
    height: 0.52em;
    background: rgba(42, 32, 27, 0.20);
    flex-shrink: 0;
  }

  /* ── Name — premium editorial, NOT techno uppercase ─
   * Title case, tight negative tracking, heavy weight.
   * Feels Apple / luxury brand, not gym / cyberpunk.
   * :global() needed — React Island renders the h1 outside Astro scoping.
   */
  :global(.hero-heading) {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw + 0.4rem, 3.4rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.025em;
    color: var(--color-cafe);
    margin: 0 0 clamp(0.5rem, 1vw, 0.75rem);
  }

  /* ── Role ────────────────────────────────────────── */
  .hero-role {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(42, 32, 27, 0.55);
    margin: 0 0 clamp(1.5rem, 3vw, 2rem);
    animation: hero-up 1000ms var(--ease-premium) 660ms both;
  }

  /* ── Decorative rule ─────────────────────────────── */
  .hero-rule {
    width: 2.5rem;
    height: 1px;
    background: rgba(42, 32, 27, 0.22);
    margin: 0 auto clamp(1.5rem, 3vw, 2rem);
    animation: hero-fade 900ms var(--ease-premium) 820ms both;
  }

  /* ── Body copy ───────────────────────────────────── */
  .hero-body {
    font-family: var(--font-body);
    font-size: clamp(0.9375rem, 1.2vw + 0.5rem, 1.125rem);
    line-height: 1.75;
    color: rgba(42, 32, 27, 0.74);
    max-width: 36ch;
    margin: 0 auto clamp(2rem, 4vw, 3rem);
    animation: hero-up 1000ms var(--ease-premium) 960ms both;
  }

  /* ── CTA group ───────────────────────────────────── */
  .cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.75rem, 1.75vw, 1rem);
    align-items: center;
    justify-content: center;
    animation: hero-up 900ms var(--ease-premium) 1100ms both;
  }

  .btn-wa {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-inverse);
    background-color: var(--color-cafe);
    border: 1px solid var(--color-cafe);
    border-radius: var(--radius-button);
    padding: 0.9rem 1.35rem;
    text-decoration: none;
    letter-spacing: 0.01em;
    transition:
      background-color var(--dur-base) var(--ease-out),
      box-shadow       var(--dur-slow) var(--ease-out),
      transform        var(--dur-fast) var(--ease-out);
  }

  .btn-wa svg { flex-shrink: 0; }

  .btn-wa:hover {
    background-color: var(--color-cafe-negro);
    border-color: var(--color-cafe-negro);
    box-shadow: var(--shadow-button);
    transform: translateY(-2px);
  }

  .cta-group :global(.hero-cta) {
    border-radius: var(--radius-button);
    font-size: 0.9375rem;
    line-height: 1.7;
    font-weight: 500;
    letter-spacing: 0.01em;
    padding-inline: 1.35rem;
    padding-block: 0.9rem;
    border-color: rgba(42, 32, 27, 0.28);
    background-color: rgba(247, 244, 238, 0.40);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition:
      background-color var(--dur-base) var(--ease-out),
      border-color     var(--dur-base) var(--ease-out),
      box-shadow       var(--dur-slow) var(--ease-out),
      transform        var(--dur-fast) var(--ease-out);
  }

  .cta-group :global(.hero-cta:hover) {
    background-color: rgba(247, 244, 238, 0.70);
    border-color: rgba(42, 32, 27, 0.42);
    box-shadow: 0 2px 14px rgba(42, 32, 27, 0.08);
    transform: translateY(-1px);
  }

  /* ── Layer 3: Scroll indicator ───────────────────── */
  .hero-scroll {
    position: absolute;
    bottom: calc(clamp(1.25rem, 4vh, 2rem) + env(safe-area-inset-bottom, 0px));
    left: 50%;
    transform: translateX(-50%);
    z-index: 4;
    color: rgba(42, 32, 27, 0.32);
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    padding: 0.5rem;
    transition: color var(--dur-base) var(--ease-out);
    animation:
      hero-fade 1200ms var(--ease-premium) 1600ms both,
      hero-drift 2800ms ease-in-out 2800ms infinite;
  }

  .hero-scroll:hover {
    color: rgba(42, 32, 27, 0.65);
  }

  /* ════════════════════════════════════════════════
   * KEYFRAMES
   * ════════════════════════════════════════════════ */

  @keyframes hero-bg-in {
    from {
      opacity: 0;
      transform: scale(1.06);
    }
    to {
      opacity: 1;
      transform: scale(1.04);
    }
  }

  @keyframes hero-up {
    from { opacity: 0; transform: translateY(8px); filter: blur(2.5px); }
    to   { opacity: 1; transform: translateY(0);   filter: blur(0px);   }
  }

  @keyframes hero-fade {
    from { opacity: 0; filter: blur(2px); }
    to   { opacity: 1; filter: blur(0px); }
  }

  @keyframes hero-drift {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%       { transform: translateX(-50%) translateY(5px); }
  }

  /* ── Mobile: stack CTAs ─────────────────────────── */
  @media (max-width: 560px) {
    .cta-group {
      flex-direction: column;
      width: 100%;
      max-width: 20rem;
    }
    .btn-wa {
      width: 100%;
      justify-content: center;
    }
    .cta-group :global(.hero-cta) {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
  }

  /* Mobile only: subtle rightward pan — laptop stays in frame, beach balance kept. */
  @media (max-width: 767px) {
    .hero-bg-img {
      object-position: 65% 38%;
    }
  }

  /* ── Very small phones ────────────────────────── */
  @media (max-width: 360px) {
    .hero-stage {
      padding-inline: 1.25rem;
      padding-top: 2.5rem;
      padding-bottom: 3.5rem;
    }
  }

  /* ── Reduced motion ──────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .hero-kicker,
    .hero-role,
    .hero-rule,
    .hero-body,
    .cta-group {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .hero-scroll {
      animation: none;
      opacity: 1;
      transform: translateX(-50%);
    }
    .hero-bg-img {
      animation: none;
      opacity: 1;
      transform: scale(1.04);
      filter: blur(0.4px) saturate(0.92) brightness(1.0) contrast(0.98) sepia(0);
    }
    .btn-wa:hover { transform: none; }
    .cta-group :global(.hero-cta:hover) { transform: none; }
  }
</style>
