---
import Button from '@/components/ui/Button.astro';
import { getWhatsAppLink } from '@/lib/whatsapp';

const waLink = getWhatsAppLink('hero');
---

<section class="hero" id="inicio" aria-label="Presentación principal">

  <!-- Layer 1: Atmospheric background image -->
  <div class="hero-bg" aria-hidden="true">
    <img
      src="/images/branding/hero.png"
      alt=""
      width="1080"
      height="1440"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      class="hero-bg-img"
    />
  </div>

  <!-- Layer 2: Warm ivory overlay — preserves readability, kills wallpaper feel -->
  <div class="hero-overlay" aria-hidden="true"></div>

  <!-- Layer 3: Centered editorial content -->
  <div class="hero-stage">

    <div class="hero-logo-wrap" aria-hidden="true">
      <img
        src="/images/branding/logo.png"
        alt="AntonyDev — Antony Valdovinos"
        width="500"
        height="500"
        loading="eager"
        decoding="async"
        class="hero-logo"
      />
    </div>

    <!-- No spaces between children: text nodes create phantom flex items -->
    <p class="hero-kicker"><span class="hero-kicker-item">Desarrollo web</span><span class="hero-kicker-sep" aria-hidden="true"></span><span class="hero-kicker-item">Diseño</span><span class="hero-kicker-sep" aria-hidden="true"></span><span class="hero-kicker-item">Sistemas</span></p>

    <h1 class="hero-heading">Antonio Valdovinos</h1>
    <p class="hero-role">Fullstack web developer</p>

    <div class="hero-rule" aria-hidden="true"></div>

    <p class="hero-body">
      Creo sitios web, sistemas a medida e identidades visuales para
      negocios que necesitan algo que funcione de verdad.
      Trabajo en Zihuatanejo y de forma remota.
    </p>

    <div class="cta-group">
      <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-wa">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
          <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.122 1.532 5.847L.057 23.882l6.196-1.453A11.954 11.954 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.816 9.816 0 01-5.015-1.374l-.36-.214-3.727.874.93-3.615-.234-.371A9.818 9.818 0 012.182 12C2.182 6.58 6.58 2.182 12 2.182S21.818 6.58 21.818 12 17.42 21.818 12 21.818z"/>
        </svg>
        Auditoría gratuita
      </a>
      <Button href="/#servicios" variant="secondary" size="lg" class="hero-cta">
        Ver servicios&nbsp;→
      </Button>
    </div>

  </div>

  <!-- Scroll indicator -->
  <a href="#servicios" class="hero-scroll" aria-label="Ver servicios">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 5v14M5 12l7 7 7-7"/>
    </svg>
  </a>

</section>

<style>
  /* ══════════════════════════════════════════════════════
   * HERO — Editorial cinematic centered
   * Four-layer stack: bg-image → overlay → content → scroll
   * ══════════════════════════════════════════════════════ */

  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: var(--color-marfil);
    margin-top: -1px;
    border-bottom: 1px solid rgba(42, 32, 27, 0.045);
  }

  /* ── Layer 1: Background image ──────────────────────── */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /*
   * scale(1.04) prevents blur() from revealing the container edge.
   * The animation zooms from 1.07→1.04 so the image "settles" while fading in.
   */
  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 38%;
    display: block;
    animation: hero-bg-develop 2400ms var(--ease-premium) 0ms both;
  }

  /* ── Layer 2: Warm ivory overlay ─────────────────────── */
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    /* Hueso at 55%: warm, light enough to preserve image texture */
    background: rgba(247, 244, 238, 0.55);
    pointer-events: none;
  }

  /* ── Layer 3: Centered editorial stage ───────────────── */
  .hero-stage {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 52rem;
    padding-inline: clamp(1.5rem, 6vw, 4rem);
    /*
     * Padding-top larger than bottom — compensates visually for header
     * height so content reads as "centered in viewport" to the eye.
     */
    padding-top: clamp(4rem, 12vh, 8rem);
    padding-bottom: clamp(5rem, 14vh, 9rem);
    margin-inline: auto;
  }

  /* ── Brand mark ──────────────────────────────────────── */
  .hero-logo-wrap {
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
    animation: hero-fade-up 1100ms var(--ease-premium) 200ms both;
  }

  .hero-logo {
    display: block;
    height: clamp(88px, 10vw, 144px);
    width: auto;
    mix-blend-mode: multiply;
  }

  /* ── Editorial kicker ────────────────────────────────── */
  .hero-kicker {
    font-family: var(--font-body);
    font-size: 0.6rem;
    font-weight: 400;
    letter-spacing: 0.27em;
    text-transform: uppercase;
    color: rgba(42, 32, 27, 0.52);
    margin: 0 0 clamp(0.75rem, 1.5vw, 1rem);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.68em;
    flex-wrap: wrap;
    animation: hero-fade-up 900ms var(--ease-premium) 400ms both;
  }

  .hero-kicker-sep {
    width: 1px;
    height: 0.52em;
    background: rgba(42, 32, 27, 0.2);
    flex-shrink: 0;
  }

  /* ── Name ────────────────────────────────────────────── */
  .hero-heading {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 5vw + 0.25rem, 3.5rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-cafe);
    margin: 0 0 clamp(0.5rem, 1vw, 0.75rem);
    animation: hero-fade-up 1000ms var(--ease-premium) 560ms both;
  }

  /* ── Role ────────────────────────────────────────────── */
  .hero-role {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(42, 32, 27, 0.58);
    margin: 0 0 clamp(1.5rem, 3vw, 2rem);
    animation: hero-fade-up 1000ms var(--ease-premium) 700ms both;
  }

  /* ── Decorative rule ─────────────────────────────────── */
  .hero-rule {
    width: 2.5rem;
    height: 1px;
    background: rgba(42, 32, 27, 0.25);
    margin: 0 auto clamp(1.5rem, 3vw, 2rem);
    animation: hero-fade 900ms var(--ease-premium) 860ms both;
  }

  /* ── Body copy ───────────────────────────────────────── */
  .hero-body {
    font-family: var(--font-body);
    font-size: clamp(0.9375rem, 1.2vw + 0.5rem, 1.125rem);
    line-height: 1.75;
    color: rgba(42, 32, 27, 0.7);
    max-width: 38ch;
    margin: 0 auto clamp(2rem, 4vw, 3rem);
    animation: hero-fade-up 1000ms var(--ease-premium) 1000ms both;
  }

  /* ── CTAs ────────────────────────────────────────────── */
  .cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.75rem, 1.75vw, 1.125rem);
    align-items: center;
    justify-content: center;
    animation: hero-fade-up 900ms var(--ease-premium) 1150ms both;
  }

  .btn-wa {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-inverse);
    background-color: var(--color-cafe);
    border: 1px solid var(--color-cafe);
    border-radius: var(--radius-button);
    padding: 0.9rem 1.35rem;
    text-decoration: none;
    letter-spacing: 0.01em;
    transition:
      background-color var(--dur-base) var(--ease-out),
      box-shadow       var(--dur-slow) var(--ease-out),
      transform        var(--dur-fast) var(--ease-out);
  }

  .btn-wa svg { flex-shrink: 0; }

  .btn-wa:hover {
    background-color: var(--color-cafe-negro);
    border-color: var(--color-cafe-negro);
    box-shadow: var(--shadow-button);
    transform: translateY(-2px);
  }

  .cta-group :global(.hero-cta) {
    border-radius: var(--radius-button);
    font-size: 0.9375rem;
    line-height: 1.7;
    font-weight: 500;
    letter-spacing: 0.01em;
    padding-inline: 1.35rem;
    padding-block: 0.9rem;
    border-color: rgba(42, 32, 27, 0.28);
    background-color: rgba(247, 244, 238, 0.35);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition:
      background-color var(--dur-base) var(--ease-out),
      border-color     var(--dur-base) var(--ease-out),
      box-shadow       var(--dur-slow) var(--ease-out),
      transform        var(--dur-fast) var(--ease-out);
  }

  .cta-group :global(.hero-cta:hover) {
    background-color: rgba(247, 244, 238, 0.68);
    border-color: rgba(42, 32, 27, 0.42);
    box-shadow: 0 2px 14px rgba(42, 32, 27, 0.08);
    transform: translateY(-1px);
  }

  /* ── Scroll indicator ────────────────────────────────── */
  .hero-scroll {
    position: absolute;
    bottom: clamp(1.25rem, 4vh, 2rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    color: rgba(42, 32, 27, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    border-radius: var(--radius-full);
    padding: 0.5rem;
    transition: color var(--dur-base) var(--ease-out);
    animation:
      hero-fade 1200ms var(--ease-premium) 1800ms both,
      hero-scroll-drift 2600ms ease-in-out 3000ms infinite;
  }

  .hero-scroll:hover {
    color: rgba(42, 32, 27, 0.65);
  }

  /* ════════════════════════════════════════════════════
   * KEYFRAMES — soft fade-in only, no aggressive motion
   * ════════════════════════════════════════════════════ */

  /* Background image: zooms gently from 1.07→1.04 as it develops */
  @keyframes hero-bg-develop {
    0% {
      opacity: 0;
      transform: scale(1.07);
      filter: blur(6px) saturate(0.65) brightness(1.15) contrast(0.85) sepia(0.18);
    }
    100% {
      opacity: 1;
      transform: scale(1.04);
      filter: blur(2.5px) saturate(0.70) brightness(1.10) contrast(0.90) sepia(0.12);
    }
  }

  /* Text elements: soft vertical lift */
  @keyframes hero-fade-up {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Rule and overlay elements: pure fade */
  @keyframes hero-fade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* Scroll indicator gentle drift */
  @keyframes hero-scroll-drift {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%       { transform: translateX(-50%) translateY(5px); }
  }

  /* ── Reduced motion ──────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .hero-logo-wrap,
    .hero-kicker,
    .hero-heading,
    .hero-role,
    .hero-rule,
    .hero-body,
    .cta-group,
    .hero-scroll {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .hero-scroll {
      transform: translateX(-50%);
    }

    .hero-bg-img {
      animation: none;
      opacity: 1;
      transform: scale(1.04);
      filter: blur(2.5px) saturate(0.70) brightness(1.10) contrast(0.90) sepia(0.12);
    }

    .btn-wa:hover,
    .cta-group :global(.hero-cta:hover) {
      transform: none;
    }
  }

  /* ── Narrow mobile: stack CTAs vertically ────────────── */
  @media (max-width: 480px) {
    .cta-group {
      flex-direction: column;
      width: 100%;
      max-width: 18rem;
    }

    .btn-wa {
      width: 100%;
      justify-content: center;
    }

    .cta-group :global(.hero-cta) {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
  }
</style>
