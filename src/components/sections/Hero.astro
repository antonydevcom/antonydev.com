---
import Button from '@/components/ui/Button.astro';
import { getWhatsAppLink } from '@/lib/whatsapp';

const waLink = getWhatsAppLink('hero');
---

<section class="hero" id="inicio" aria-label="Presentación principal">

  <!-- z:0 — Atmospheric background image, absolutely covers the section -->
  <div class="hero-bg" aria-hidden="true">
    <img
      src="/images/branding/hero.png"
      alt=""
      width="1080"
      height="1440"
      loading="eager"
      decoding="async"
      fetchpriority="high"
      class="hero-bg-img"
    />
  </div>

  <!-- z:1 — Warm ivory wash over the image -->
  <div class="hero-overlay" aria-hidden="true"></div>

  <!-- z:2 — Centered editorial content -->
  <div class="hero-stage">

    <div class="hero-logo-wrap" aria-hidden="true">
      <div class="hero-logo-inner">
        <img
          src="/images/branding/logo.png"
          alt="AntonyDev — Antony Valdovinos"
          width="500"
          height="500"
          loading="eager"
          decoding="async"
          class="hero-logo"
        />
      </div>
    </div>

    <p class="hero-kicker"><span class="hero-kicker-item">Desarrollo web</span><span class="hero-kicker-sep" aria-hidden="true"></span><span class="hero-kicker-item">Diseño</span><span class="hero-kicker-sep" aria-hidden="true"></span><span class="hero-kicker-item">Sistemas</span></p>

    <h1 class="hero-heading">Antonio Valdovinos</h1>
    <p class="hero-role">Fullstack web developer</p>

    <div class="hero-rule" aria-hidden="true"></div>

    <p class="hero-body">
      Creo sitios web, sistemas a medida e identidades visuales para
      negocios que necesitan algo que funcione de verdad.
      Trabajo en Zihuatanejo y de forma remota.
    </p>

    <div class="cta-group">
      <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-wa">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
          <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.122 1.532 5.847L.057 23.882l6.196-1.453A11.954 11.954 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.816 9.816 0 01-5.015-1.374l-.36-.214-3.727.874.93-3.615-.234-.371A9.818 9.818 0 012.182 12C2.182 6.58 6.58 2.182 12 2.182S21.818 6.58 21.818 12 17.42 21.818 12 21.818z"/>
        </svg>
        Auditoría gratuita
      </a>
      <Button href="/#servicios" variant="secondary" size="lg" class="hero-cta">
        Ver servicios&nbsp;→
      </Button>
    </div>

  </div>

  <!-- z:4 — Scroll indicator -->
  <a href="#servicios" class="hero-scroll" aria-label="Ver servicios">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 5v14M5 12l7 7 7-7"/>
    </svg>
  </a>

</section>

<style>
  /* ══════════════════════════════════════════════════
   * HERO — Full-bleed layered cinematic composition.
   * isolation: isolate creates a self-contained stacking
   * context so z-indexes here never conflict with the navbar.
   * ══════════════════════════════════════════════════ */

  .hero {
    position: relative;
    isolation: isolate;        /* own stacking context */
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: var(--color-marfil);
    margin-top: -1px;
    border-bottom: 1px solid rgba(42, 32, 27, 0.045);
  }

  :global(body.page-home) .hero {
    margin-top: 0;
    /* Fill dynamic viewport (mobile URL bar) so no marfil strip under the photo */
    min-height: 100svh;
    min-height: 100dvh;
  }

  /* ── Layer 0: Background image ──────────────────────
   * Absolutely covers the full section.
   * Explicit top/right/bottom/left instead of inset shorthand
   * avoids any browser quirk with the shorthand in flex contexts.
   */
  .hero-bg {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 0;
    /* Explicit dimensions in case % doesn't resolve through flex */
    width: 100%;
    height: 100%;
  }

  /*
   * Image fills the bg container.
   * !important on width/height beats the Tailwind base reset
   * (img { height: auto }) which lives in @layer base.
   * scale(1.04) pushes the blurred edges outside overflow:hidden.
   */
  .hero-bg-img {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    object-fit: cover;
    object-position: 60% 38%;
    transform: scale(1.04);
    filter: blur(0.4px) saturate(0.92) brightness(1.0) contrast(0.98) sepia(0);
    animation: hero-bg-in 2200ms var(--ease-premium) 0ms both;
  }

  /* ── Layer 1: Warm overlay ───────────────────────── */
  .hero-overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    /* Dark warm instead of ivory fog — preserves image colors and depth */
    background: rgba(30, 23, 19, 0.14);
    pointer-events: none;
  }

  /* ── Layer 2: Centered editorial stage ───────────── */
  .hero-stage {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 52rem;
    padding-inline: clamp(1.5rem, 6vw, 4rem);
    padding-top: clamp(3.5rem, 10vh, 7rem);
    padding-bottom: clamp(4.5rem, 12vh, 8rem);
  }

  /* ── Logo mark — luxury reveal, then slow editorial float ─ */
  .hero-logo-wrap {
    margin-bottom: clamp(1.35rem, 2.75vw, 2.15rem);
    transform-origin: 50% 55%;
    will-change: transform, filter;
    animation:
      hero-logo-float        5.75s cubic-bezier(0.45, 0, 0.55, 1) 2s infinite,
      hero-logo-float-shadow 5.75s cubic-bezier(0.45, 0, 0.55, 1) 2s infinite;
  }

  .hero-logo-inner {
    display: block;
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    transform-origin: 50% 58%;
    backface-visibility: hidden;
    animation: hero-logo-reveal 1.68s cubic-bezier(0.22, 1, 0.36, 1) 0.06s both;
  }

  .hero-logo {
    display: block !important;
    height: clamp(104px, 12.5vw, 172px) !important;
    width: auto !important;
    max-width: none !important;
    mix-blend-mode: multiply;
    animation: hero-logo-luminate 1.72s cubic-bezier(0.22, 1, 0.36, 1) 0.06s both;
  }

  /* ── Kicker — small label rail ───────────────────── */
  .hero-kicker {
    font-family: var(--font-body);
    font-size: 0.6rem;
    font-weight: 400;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(42, 32, 27, 0.50);
    margin: 0 0 clamp(0.75rem, 1.5vw, 1rem);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65em;
    flex-wrap: wrap;
    animation: hero-up 900ms var(--ease-premium) 360ms both;
  }

  .hero-kicker-sep {
    width: 1px;
    height: 0.52em;
    background: rgba(42, 32, 27, 0.20);
    flex-shrink: 0;
  }

  /* ── Name — premium editorial, NOT techno uppercase ─
   * Title case, tight negative tracking, heavy weight.
   * Feels Apple / luxury brand, not gym / cyberpunk.
   */
  .hero-heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw + 0.4rem, 3.4rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.025em;
    color: var(--color-cafe);
    margin: 0 0 clamp(0.5rem, 1vw, 0.75rem);
    animation: hero-up 1000ms var(--ease-premium) 520ms both;
  }

  /* ── Role ────────────────────────────────────────── */
  .hero-role {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(42, 32, 27, 0.55);
    margin: 0 0 clamp(1.5rem, 3vw, 2rem);
    animation: hero-up 1000ms var(--ease-premium) 660ms both;
  }

  /* ── Decorative rule ─────────────────────────────── */
  .hero-rule {
    width: 2.5rem;
    height: 1px;
    background: rgba(42, 32, 27, 0.22);
    margin: 0 auto clamp(1.5rem, 3vw, 2rem);
    animation: hero-fade 900ms var(--ease-premium) 820ms both;
  }

  /* ── Body copy ───────────────────────────────────── */
  .hero-body {
    font-family: var(--font-body);
    font-size: clamp(0.9375rem, 1.2vw + 0.5rem, 1.125rem);
    line-height: 1.75;
    color: rgba(42, 32, 27, 0.74);
    max-width: 36ch;
    margin: 0 auto clamp(2rem, 4vw, 3rem);
    animation: hero-up 1000ms var(--ease-premium) 960ms both;
  }

  /* ── CTA group ───────────────────────────────────── */
  .cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.75rem, 1.75vw, 1rem);
    align-items: center;
    justify-content: center;
    animation: hero-up 900ms var(--ease-premium) 1100ms both;
  }

  .btn-wa {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-inverse);
    background-color: var(--color-cafe);
    border: 1px solid var(--color-cafe);
    border-radius: var(--radius-button);
    padding: 0.9rem 1.35rem;
    text-decoration: none;
    letter-spacing: 0.01em;
    transition:
      background-color var(--dur-base) var(--ease-out),
      box-shadow       var(--dur-slow) var(--ease-out),
      transform        var(--dur-fast) var(--ease-out);
  }

  .btn-wa svg { flex-shrink: 0; }

  .btn-wa:hover {
    background-color: var(--color-cafe-negro);
    border-color: var(--color-cafe-negro);
    box-shadow: var(--shadow-button);
    transform: translateY(-2px);
  }

  .cta-group :global(.hero-cta) {
    border-radius: var(--radius-button);
    font-size: 0.9375rem;
    line-height: 1.7;
    font-weight: 500;
    letter-spacing: 0.01em;
    padding-inline: 1.35rem;
    padding-block: 0.9rem;
    border-color: rgba(42, 32, 27, 0.28);
    background-color: rgba(247, 244, 238, 0.40);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition:
      background-color var(--dur-base) var(--ease-out),
      border-color     var(--dur-base) var(--ease-out),
      box-shadow       var(--dur-slow) var(--ease-out),
      transform        var(--dur-fast) var(--ease-out);
  }

  .cta-group :global(.hero-cta:hover) {
    background-color: rgba(247, 244, 238, 0.70);
    border-color: rgba(42, 32, 27, 0.42);
    box-shadow: 0 2px 14px rgba(42, 32, 27, 0.08);
    transform: translateY(-1px);
  }

  /* ── Layer 3: Scroll indicator ───────────────────── */
  .hero-scroll {
    position: absolute;
    bottom: clamp(1.25rem, 4vh, 2rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 4;
    color: rgba(42, 32, 27, 0.32);
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    padding: 0.5rem;
    transition: color var(--dur-base) var(--ease-out);
    animation:
      hero-fade 1200ms var(--ease-premium) 1600ms both,
      hero-drift 2800ms ease-in-out 2800ms infinite;
  }

  .hero-scroll:hover {
    color: rgba(42, 32, 27, 0.65);
  }

  /* ════════════════════════════════════════════════
   * KEYFRAMES
   * ════════════════════════════════════════════════ */

  @keyframes hero-bg-in {
    from {
      opacity: 0;
      transform: scale(1.06);
    }
    to {
      opacity: 1;
      transform: scale(1.04);
    }
  }

  /* Logo: curtain reveal + magnetic settle — reads high-end, not flashy */
  @keyframes hero-logo-reveal {
    0% {
      opacity: 0;
      clip-path: inset(88% 8% 0% 8% round 2px);
      transform: translateY(2.75rem) scale(0.88) rotate(-2deg);
    }
    28% {
      opacity: 1;
      clip-path: inset(0% 0% 0% 0% round 2px);
      transform: translateY(0.85rem) scale(0.96) rotate(-0.5deg);
    }
    52% {
      transform: translateY(-0.85rem) scale(1.055) rotate(0.55deg);
    }
    72% {
      transform: translateY(0.35rem) scale(0.99) rotate(0deg);
    }
    100% {
      opacity: 1;
      clip-path: inset(0% 0% 0% 0%);
      transform: translateY(0) scale(1) rotate(0deg);
    }
  }

  /* Light sculpts the mark — three-beat then rest at natural values */
  @keyframes hero-logo-luminate {
    0% {
      filter:
        brightness(0.72)
        contrast(1.12)
        saturate(0.75)
        drop-shadow(0 2rem 3rem rgba(42, 32, 27, 0));
    }
    22% {
      filter:
        brightness(1.42)
        contrast(0.9)
        saturate(0.88)
        drop-shadow(0 0.5rem 1.25rem rgba(42, 32, 27, 0.1));
    }
    48% {
      filter:
        brightness(1.12)
        contrast(1.04)
        saturate(1.02)
        drop-shadow(0 0.65rem 1.6rem rgba(42, 32, 27, 0.16));
    }
    100% {
      filter:
        brightness(1)
        contrast(1)
        saturate(1)
        drop-shadow(0 0.45rem 1.15rem rgba(42, 32, 27, 0.08));
    }
  }

  /* After load: slow levitation — noticeable, still editorial */
  @keyframes hero-logo-float {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    22% {
      transform: translateY(-14px) rotate(0.55deg);
    }
    48% {
      transform: translateY(-5px) rotate(0.2deg);
    }
    74% {
      transform: translateY(11px) rotate(-0.4deg);
    }
  }

  @keyframes hero-logo-float-shadow {
    0%,
    100% {
      filter: drop-shadow(0 14px 26px rgba(42, 32, 27, 0.1));
    }
    48% {
      filter: drop-shadow(0 22px 38px rgba(42, 32, 27, 0.14));
    }
    74% {
      filter: drop-shadow(0 10px 20px rgba(42, 32, 27, 0.08));
    }
  }

  @keyframes hero-up {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes hero-fade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @keyframes hero-drift {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%       { transform: translateX(-50%) translateY(5px); }
  }

  /* ── Narrow mobile: stack CTAs ───────────────────── */
  @media (max-width: 480px) {
    .cta-group {
      flex-direction: column;
      width: 100%;
      max-width: 18rem;
    }
    .btn-wa {
      width: 100%;
      justify-content: center;
    }
    .cta-group :global(.hero-cta) {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
  }

  /* ── Reduced motion ──────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .hero-logo-wrap,
    .hero-logo-inner,
    .hero-logo {
      animation: none !important;
      will-change: auto;
    }
    .hero-logo-wrap,
    .hero-logo-inner {
      opacity: 1;
      transform: none;
      filter: none;
    }
    .hero-logo {
      opacity: 1;
      filter: none;
    }
    .hero-kicker,
    .hero-heading,
    .hero-role,
    .hero-rule,
    .hero-body,
    .cta-group {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .hero-scroll {
      animation: none;
      opacity: 1;
      transform: translateX(-50%);
    }
    .hero-bg-img {
      animation: none;
      opacity: 1;
      transform: scale(1.04);
      filter: blur(0.4px) saturate(0.92) brightness(1.0) contrast(0.98) sepia(0);
    }
    .btn-wa:hover { transform: none; }
    .cta-group :global(.hero-cta:hover) { transform: none; }
  }
</style>
