---
import Container from '@/components/ui/Container.astro';
import { ProjectCards } from '@/components/motion/ProjectCards';
import { SectionHeaderReveal } from '@/components/motion/SectionHeaderReveal';

const projects = [
  {
    title: 'Suspiros de Papel',
    category: 'Diseño Web · Identidad Digital',
    tagline: 'Sitio web y catálogo digital para una marca de sublimación y grabado láser en Guerrero.',
    image: '/images/projects/suspirosdepapel.webp',
    imageAlt: 'Sitio web de Suspiros de Papel — sublimación, grabado láser y papelería creativa',
    imageWidth: 1140,
    imageHeight: 717,
    imagePosition: 'center',
    href: 'https://www.suspirosdepapel.net',
  },
  {
    title: 'Blanca Ríos Estudio',
    category: 'Diseño Web · Agenda Online',
    tagline: 'Sitio web con agenda integrada para un estudio de barbería y estética.',
    image: '/images/projects/blancariosestudio.webp',
    imageAlt: 'Sitio web de Blanca Ríos Estudio — barbería y servicios de belleza con agenda integrada',
    imageWidth: 1135,
    imageHeight: 716,
    imagePosition: 'center top',
    href: 'https://www.blancariosestudio.com',
  },
  {
    title: 'Marino Zihua',
    category: 'Diseño Web · Catálogo Digital',
    tagline: 'Catálogo digital y marca visual para un estudio de interiorismo artesanal en Zihuatanejo.',
    image: '/images/projects/marinozihua.webp',
    imageAlt: 'Sitio web de Marino Zihua — estudio de diseño artesanal e interiorismo',
    imageWidth: 1137,
    imageHeight: 716,
    imagePosition: 'center',
    href: 'https://www.marinozihua.net',
  },
];
---

<section class="projects" id="portafolio" aria-labelledby="projects-heading">
  <Container>

    <SectionHeaderReveal
      eyebrow="Trabajo seleccionado"
      heading="Proyectos recientes"
      headingId="projects-heading"
      client:visible
    />

    <ProjectCards projects={projects} client:visible />

  </Container>
</section>

<style>
  .projects {
    position: relative;
    z-index: 1;
    background-color: var(--bg-surface);
    padding-top: 3.75rem;
    padding-bottom: 3.75rem;
    border-bottom: 1px solid var(--border);
  }

  @media (min-width: 768px) {
    .projects {
      margin-top: -2.25rem;
      padding-top: calc(8rem + 2.25rem);
      padding-bottom: 8rem;
      background-color: rgba(247, 244, 238, 0.58);
      -webkit-backdrop-filter: var(--glass-section);
      backdrop-filter: var(--glass-section);
      border-bottom-color: rgba(42, 32, 27, 0.1);
    }
  }

  @supports not ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
    @media (min-width: 768px) {
      .projects {
        margin-top: 0;
        padding-top: 9rem;
        background-color: var(--bg-surface);
        border-bottom-color: var(--border);
      }
    }
  }

</style>

<style is:global>
  /* ── Projects section header — per-section overrides ─── */

  .projects .section-header {
    text-align: center;
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }

  .projects .eyebrow {
    text-align: center;
    margin-bottom: var(--space-3);
  }

  .projects .section-header h2 {
    text-align: center;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-4);
  }

  /* ── Grid ─────────────────────────────────────────── */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .projects-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
    .card-image {
      aspect-ratio: 3 / 2;  /* slightly taller than 16/9 — more cinematic presence */
    }
    .card-info {
      padding: var(--space-6);
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ── Card ─────────────────────────────────────────── */
  .project-card {
    display: block;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background-color: var(--bg-page);
    border: 1px solid var(--border);
    /* Resting shadow — three warm layers for depth at rest */
    box-shadow:
      0 2px  6px  rgba(42, 32, 27, 0.06),
      0 6px  20px rgba(42, 32, 27, 0.08),
      0 16px 40px rgba(42, 32, 27, 0.05);
    text-decoration: none;
    color: inherit;
    position: relative;
    transition:
      box-shadow    420ms           var(--ease-out),
      border-color  var(--dur-base) var(--ease-out);
    /* transform handled by Motion whileHover — no CSS transform here */
  }

  .project-card:hover {
    /* Four-layer hover: near → mid → far → atmospheric halo */
    box-shadow:
      0 2px   6px  rgba(42, 32, 27, 0.05),
      0 8px  24px  rgba(42, 32, 27, 0.11),
      0 24px 64px  rgba(42, 32, 27, 0.15),
      0 48px 80px  rgba(42, 32, 27, 0.07);
    border-color: rgba(42, 32, 27, 0.18);
  }

  /* ── Card image area ─────────────────────────────── */
  .card-image {
    position: relative;
    aspect-ratio: 4 / 3;   /* taller on mobile — more visual weight */
    overflow: hidden;
    background-color: var(--bg-surface);
  }

  .card-image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 480ms var(--ease-out);
  }

  .project-card:hover .card-image img {
    transform: scale(1.06);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(30, 23, 19, 0.46);
    -webkit-backdrop-filter: var(--glass-overlay);
    backdrop-filter: var(--glass-overlay);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
    opacity: 0;
    transition:
      opacity var(--dur-base) var(--ease-out),
      backdrop-filter var(--dur-base) var(--ease-out),
      -webkit-backdrop-filter var(--dur-base) var(--ease-out);
  }

  @supports not ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
    .card-overlay {
      background-color: rgba(30, 23, 19, 0.82);
    }
  }

  .project-card:hover .card-overlay {
    opacity: 1;
  }

  .overlay-tagline {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-hueso);
    text-align: center;
    margin: 0;
    line-height: 1.55;
  }

  /* ── Card info row ───────────────────────────────── */
  .card-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.125rem;
    gap: var(--space-4);
  }

  .card-meta {
    min-width: 0;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
    margin: 0 0 var(--space-1) 0;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .card-category {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--color-cafe);
    margin: 0;
  }

  .card-arrow {
    color: var(--text-muted);
    flex-shrink: 0;
    transition:
      transform var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  .project-card:hover .card-arrow {
    transform: translate(2px, -2px);
    color: var(--text-primary);
  }
</style>
