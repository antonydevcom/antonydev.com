---
import '@/styles/service-cards.css';
import Container from '@/components/ui/Container.astro';
import { ServiceCards } from '@/components/motion/ServiceCards';
import { SectionHeaderReveal } from '@/components/motion/SectionHeaderReveal';

const phases = [
  {
    number: '01',
    label: 'Fase 1',
    title: 'Auditoría',
    description: 'Reviso tu presencia online y analizo tu competencia local. Te entrego un reporte con recomendaciones concretas de qué necesitas y por qué. Sin rodeos.',
    detail: 'Gratis para nuevos clientes',
    href: '/servicios/auditoria',
  },
  {
    number: '02',
    label: 'Fase 2',
    title: 'Creación',
    description: 'Diseño y desarrollo tu sitio web completo: identidad visual, WhatsApp automatizado, formularios y SEO local. Listo para recibir clientes desde el día del lanzamiento.',
    detail: 'Cotización personalizada',
    href: '/servicios/creacion',
  },
  {
    number: '03',
    label: 'Fase 3',
    title: 'Mantenimiento',
    description: 'Mantengo tu sitio actualizado, seguro y funcionando. Nuevas secciones, cambios de contenido, respaldo y soporte técnico con respuesta en menos de 48 horas.',
    detail: 'Planes personalizados',
    href: '/servicios/mantenimiento',
  },
];

const extras = [
  {
    title: 'Identidad Digital',
    description: 'Paleta de colores, tipografía, tono de comunicación e imagen visual coherente para tu negocio.',
    href: '/servicios/identidad',
  },
  {
    title: 'Automatización',
    description: 'WhatsApp Business automatizado, pagos en línea, catálogos digitales y sistemas de reservas.',
    href: '/servicios/automatizacion',
  },
];
---

<section class="services" id="servicios" aria-labelledby="services-heading">
  <Container>

    <SectionHeaderReveal
      eyebrow="Servicios"
      heading="El ciclo completo para tu negocio"
      headingId="services-heading"
      subtitle="Trabajo con negocios en todo el proceso: diagnóstico, construcción y soporte continuo. Sin agencias, sin intermediarios."
      client:visible
    />

    <ServiceCards phases={phases} extras={extras} client:visible />

  </Container>
  <div id="proceso" class="nav-scroll-mark" aria-hidden="true"></div>
</section>

<style>
  .services {
    position: relative;
    z-index: 1;
    background-color: var(--bg-page);
    padding-top: clamp(4.5rem, 10vw, 7rem);
    padding-bottom: clamp(4.5rem, 10vw, 7rem);
    border-bottom: 1px solid var(--border);
  }

  @media (min-width: 768px) {
    .services {
      margin-top: -2.75rem;
      padding-top: calc(9rem + 2.75rem);
      padding-bottom: 9rem;
      background-color: rgba(238, 232, 223, 0.58);
      -webkit-backdrop-filter: var(--glass-section);
      backdrop-filter: var(--glass-section);
      border-bottom-color: rgba(42, 32, 27, 0.1);
    }
  }

  @supports not ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
    @media (min-width: 768px) {
      .services {
        margin-top: 0;
        padding-top: 9rem;
        background-color: var(--bg-page);
        border-bottom-color: var(--border);
      }
    }
  }



</style>

<style is:global>
  /* ── Services section header — per-section overrides ─── */

  .services .section-header {
    text-align: center;
    max-width: 540px;
    margin: 0 auto clamp(2.75rem, 7vw, 4rem);
  }

  .services .eyebrow {
    text-align: center;
    margin-bottom: var(--space-3);
  }

  .services .section-header h2 {
    text-align: center;
    font-size: clamp(1.875rem, 3.5vw, 2.75rem);
    letter-spacing: -0.025em;
    margin: 0 0 var(--space-4);
  }

  .services .section-divider {
    margin-bottom: var(--space-4);
  }

  .services .section-subtitle {
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.75;
    color: rgba(42, 32, 27, 0.65);
    margin: 0 auto;
    max-width: 44ch;
  }
</style>
