---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  external?: boolean;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  external = false,
  type = 'button',
  class: className,
} = Astro.props;

const externalProps = external
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

{href ? (
  <a
    href={href}
    data-variant={variant}
    data-size={size}
    data-cursor={variant === 'primary' ? 'premium' : undefined}
    class:list={['btn', className]}
    {...externalProps}
  >
    <slot />
  </a>
) : (
  <button
    type={type}
    data-variant={variant}
    data-size={size}
    data-cursor={variant === 'primary' ? 'premium' : undefined}
    class:list={['btn', className]}
  >
    <slot />
  </button>
)}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    border: 1px solid transparent;
    border-radius: var(--radius-button);
    font-family: var(--font-body);
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    user-select: none;
    transition:
      background-color var(--dur-base) var(--ease-out),
      color            var(--dur-base) var(--ease-out),
      border-color     var(--dur-base) var(--ease-out),
      box-shadow       var(--dur-slow) var(--ease-out), /* shadow arrives after color — premium layering */
      transform        var(--dur-fast) var(--ease-out);
  }

  .btn:active {
    transform: translateY(1px);
    transition-duration: 80ms;
  }

  /* ── Sizes ───────────────────────────────────────── */
  .btn[data-size='sm'] {
    padding: var(--space-2) var(--space-4);
    font-size: 0.8125rem;
  }

  .btn[data-size='md'] {
    padding: var(--space-3) var(--space-6);
    font-size: 0.9375rem;
  }

  .btn[data-size='lg'] {
    padding: var(--space-4) var(--space-8);
    font-size: 1rem;
  }

  /* ── Primary ─────────────────────────────────────── */
  .btn[data-variant='primary'] {
    background-color: var(--color-cafe);
    color: var(--color-hueso);
    border-color: var(--color-cafe);
  }

  .btn[data-variant='primary']:hover {
    background-color: var(--color-cafe-negro);
    border-color: var(--color-cafe-negro);
    box-shadow: var(--shadow-button);
    transform: translateY(-2px);
  }

  /* ── Secondary ───────────────────────────────────── */
  .btn[data-variant='secondary'] {
    background-color: transparent;
    color: var(--color-cafe);
    border-color: var(--border);
  }

  .btn[data-variant='secondary']:hover {
    background-color: var(--bg-surface);
    border-color: var(--border-hover);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }

  /* ── Ghost ───────────────────────────────────────── */
  .btn[data-variant='ghost'] {
    background-color: transparent;
    color: var(--color-cafe);
    border-color: transparent;
  }

  .btn[data-variant='ghost']:hover {
    background-color: var(--fill-ghost);
  }
</style>
