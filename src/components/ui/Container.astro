---
interface Props {
  narrow?: boolean;
  as?: string;
  class?: string;
}

const {
  narrow = false,
  as: Tag = 'div',
  class: className,
} = Astro.props;
---

<Tag class:list={['container', narrow && 'container--narrow', className]}>
  <slot />
</Tag>

<style>
  /*
   * .container base styles live in global.css (@layer components).
   * Only the narrow override is scoped here.
   */
  .container--narrow {
    max-width: 768px;
  }
</style>
