---
interface Props {
  spacing?: 'compact' | 'default' | 'large';
  id?: string;
  as?: string;
  class?: string;
}

const {
  spacing = 'default',
  id,
  as: Tag = 'section',
  class: className,
} = Astro.props;
---

<Tag id={id} data-spacing={spacing} class:list={['section', className]}>
  <slot />
</Tag>

<style>
  .section[data-spacing='compact'] {
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .section[data-spacing='default'] {
    padding-top: 5rem;
    padding-bottom: 5rem;
  }

  .section[data-spacing='large'] {
    padding-top: 7.5rem;
    padding-bottom: 7.5rem;
  }
</style>
