---
interface Props {
  variant?: 'default' | 'elevated' | 'dark';
  radius?: 'md' | 'lg' | 'xl';
  padding?: 'none' | 'sm' | 'md' | 'lg';
  as?: string;
  class?: string;
}

const {
  variant = 'default',
  radius = 'lg',
  padding = 'md',
  as: Tag = 'div',
  class: className,
} = Astro.props;
---

<Tag
  data-variant={variant}
  data-radius={radius}
  data-padding={padding}
  class:list={['surface', className]}
>
  <slot />
</Tag>

<style>
  /* ── Variants ────────────────────────────────────── */
  .surface[data-variant='default'] {
    background-color: var(--bg-surface);
    border: 1px solid var(--border);
  }

  .surface[data-variant='elevated'] {
    background-color: var(--bg-surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
  }

  /*
   * Dark variant overrides token cascade so ALL child elements
   * (h1-h6, p, etc.) automatically resolve --text-primary to the
   * inverse value — no slot-piercing or :global() needed.
   */
  .surface[data-variant='dark'] {
    background-color: var(--bg-dark);
    border: 1px solid rgba(247, 244, 238, 0.08);
    --text-primary: var(--text-inverse);
    --text-muted: rgba(247, 244, 238, 0.55);
    --border: rgba(247, 244, 238, 0.10);
  }

  /* ── Radius ──────────────────────────────────────── */
  .surface[data-radius='md'] { border-radius: var(--radius-md); }
  .surface[data-radius='lg'] { border-radius: var(--radius-lg); }
  .surface[data-radius='xl'] { border-radius: var(--radius-xl); }

  /* ── Padding ─────────────────────────────────────── */
  .surface[data-padding='none'] { padding: 0; }
  .surface[data-padding='sm']   { padding: var(--space-6); }
  .surface[data-padding='md']   { padding: var(--space-8); }
  .surface[data-padding='lg']   { padding: var(--space-12); }
</style>
