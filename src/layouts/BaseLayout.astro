---
import '@/styles/global.css';
import { PremiumCursor } from '@/components/motion/PremiumCursor';
import { LOCATION, BRAND } from '@/lib/location';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedDate?: string;
  schema?: object | object[];
  breadcrumbs?: Array<{ name: string; url: string }>;
  /** e.g. `page-home` — transparent nav over hero on index */
  bodyClass?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  type = 'website',
  publishedDate,
  schema,
  breadcrumbs,
  bodyClass,
  noindex = false,
} = Astro.props;

const SITE_URL = BRAND.siteUrl;

const canonical  = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage    = image ?? `${SITE_URL}/og-default.jpg`;
const fullTitle  = `${title} | Antonio Valdovinos — AntonyDev`;

// Injected on every page — establishes brand identity in Google's knowledge graph
const baseSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${SITE_URL}/#business`,
      'name': BRAND.name,
      'legalName': BRAND.legalName,
      'url': SITE_URL,
      'description': BRAND.description,
      'telephone': LOCATION.phone,
      'email': LOCATION.email,
      'priceRange': '$$',
      'currenciesAccepted': 'MXN',
      'paymentAccepted': 'Cash, Credit Card, Bank Transfer, MercadoPago',
      'address': {
        '@type': 'PostalAddress',
        'addressLocality': LOCATION.city,
        'addressRegion': LOCATION.state,
        'postalCode': LOCATION.postalCode,
        'addressCountry': LOCATION.countryCode,
      },
      'geo': {
        '@type': 'GeoCoordinates',
        'latitude': LOCATION.lat,
        'longitude': LOCATION.lng,
      },
      'areaServed': LOCATION.areaServed.map((area) => ({
        '@type': 'City',
        'name': area,
      })),
      'openingHoursSpecification': [
        {
          '@type': 'OpeningHoursSpecification',
          'dayOfWeek': ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
          'opens': '09:00',
          'closes': '18:00',
        },
      ],
      'founder': { '@id': `${SITE_URL}/#person` },
      'employee': { '@id': `${SITE_URL}/#person` },
      'sameAs': BRAND.sameAs,
      'hasOfferCatalog': {
        '@type': 'OfferCatalog',
        'name': 'Servicios Digitales',
        'itemListElement': [
          { '@type': 'Offer', 'itemOffered': { '@type': 'Service', 'name': 'Auditoría Digital', 'url': `${SITE_URL}/servicios/auditoria` } },
          { '@type': 'Offer', 'itemOffered': { '@type': 'Service', 'name': 'Desarrollo Web', 'url': `${SITE_URL}/servicios/creacion` } },
          { '@type': 'Offer', 'itemOffered': { '@type': 'Service', 'name': 'Mantenimiento Web', 'url': `${SITE_URL}/servicios/mantenimiento` } },
          { '@type': 'Offer', 'itemOffered': { '@type': 'Service', 'name': 'Identidad Digital', 'url': `${SITE_URL}/servicios/identidad` } },
          { '@type': 'Offer', 'itemOffered': { '@type': 'Service', 'name': 'Automatización', 'url': `${SITE_URL}/servicios/automatizacion` } },
        ],
      },
    },
    {
      '@type': 'Person',
      '@id': `${SITE_URL}/#person`,
      'name': BRAND.legalName,
      'alternateName': BRAND.alternateName,
      'jobTitle': BRAND.jobTitle,
      'url': SITE_URL,
      'email': LOCATION.email,
      'telephone': LOCATION.phone,
      'address': {
        '@type': 'PostalAddress',
        'addressLocality': LOCATION.city,
        'addressRegion': LOCATION.state,
        'addressCountry': LOCATION.countryCode,
      },
      'worksFor': { '@id': `${SITE_URL}/#business` },
      'knowsAbout': BRAND.knowsAbout,
      'sameAs': BRAND.sameAs,
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      'url': SITE_URL,
      'name': `${BRAND.name} — ${BRAND.legalName}`,
      'description': BRAND.description,
      'publisher': { '@id': `${SITE_URL}/#business` },
      'potentialAction': {
        '@type': 'SearchAction',
        'target': `${SITE_URL}/blog?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    },
  ],
};

const breadcrumbSchema = breadcrumbs
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      'itemListElement': breadcrumbs.map((crumb, i) => ({
        '@type': 'ListItem',
        'position': i + 1,
        'name': crumb.name,
        'item': `${SITE_URL}${crumb.url}`,
      })),
    }
  : null;

const allSchemas = [
  baseSchema,
  ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  ...(Array.isArray(schema) ? schema : schema ? [schema] : []),
];
---

<!DOCTYPE html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#EEE8DF" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Antonio Valdovinos" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'} />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonical} />

    <!-- OpenGraph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="AntonyDev — Antonio Valdovinos" />
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Font preloads — must match @font-face declarations in tokens.css -->
    <link rel="preload" href="/fonts/poppins-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-500.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- JSON-LD — base (always) + breadcrumbs (if provided) + page schema (if provided) -->
    {allSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <!-- Cloudflare Web Analytics — zero cookies, zero CWV impact -->
    <!-- Set PUBLIC_CF_BEACON_TOKEN env var to activate before deploy -->
    {import.meta.env.PUBLIC_CF_BEACON_TOKEN && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token":"${import.meta.env.PUBLIC_CF_BEACON_TOKEN}"}`}
      />
    )}
  </head>
  <body class:list={[bodyClass]}>
    <PremiumCursor client:load />
    <slot />
  </body>
</html>

