---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';
import { getCollection } from 'astro:content';

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Blog', url: '/blog' },
];

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime());
---

<BaseLayout
  title="Blog — Desarrollo Web en Zihuatanejo"
  description="Guías, consejos y recursos sobre desarrollo web, SEO local y digitalización de negocios en Zihuatanejo e Ixtapa. Por Antonio Valdovinos — AntonyDev."
  breadcrumbs={breadcrumbs}
>
  <Header />
  <main>

    <section class="page-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Navegación">
          <a href="/">Inicio</a><span aria-hidden="true">/</span>
          <span aria-current="page">Blog</span>
        </nav>
        <p class="phase-badge">AntonyDev · Recursos</p>
        <h1>Blog de desarrollo web en Zihuatanejo</h1>
        <p class="page-lead">
          Guías prácticas sobre desarrollo web, SEO local y digitalización de negocios
          en Zihuatanejo e Ixtapa. Escrito por <a href="/sobre-mi">Antonio Valdovinos</a>.
        </p>
      </div>
    </section>

    <section class="blog-section">
      <div class="container">
        {posts.length === 0 ? (
          <p class="blog-empty">Próximamente — los primeros artículos están en camino.</p>
        ) : (
          <div class="blog-grid">
            {posts.map((post) => (
              <article class="blog-card">
                {post.data.image && (
                  <a href={`/blog/${post.id}`} class="blog-card-img-link" tabindex="-1" aria-hidden="true">
                    <img
                      src={post.data.image}
                      alt={post.data.imageAlt ?? post.data.title}
                      width="640"
                      height="360"
                      loading="lazy"
                      decoding="async"
                      class="blog-card-img"
                    />
                  </a>
                )}
                <div class="blog-card-body">
                  <time class="blog-card-date" datetime={post.data.publishedDate}>
                    {new Date(post.data.publishedDate).toLocaleDateString('es-MX', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </time>
                  <h2 class="blog-card-title">
                    <a href={`/blog/${post.id}`}>{post.data.title}</a>
                  </h2>
                  <p class="blog-card-desc">{post.data.description}</p>
                  <a href={`/blog/${post.id}`} class="blog-card-read">Leer artículo →</a>
                </div>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
  .page-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0 0 var(--space-6);
    max-width: 22ch;
  }

  .page-lead a {
    color: var(--color-cafe);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .blog-section {
    padding: clamp(4rem, 10vw, 7rem) 0;
  }

  .blog-empty {
    font-family: var(--font-body);
    font-size: 1rem;
    color: rgba(42, 32, 27, 0.5);
    text-align: center;
    padding: var(--space-16) 0;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
  }

  @media (min-width: 640px) {
    .blog-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .blog-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    background-color: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .blog-card-img-link {
    display: block;
    overflow: hidden;
  }

  .blog-card-img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .blog-card:hover .blog-card-img {
    transform: scale(1.03);
  }

  .blog-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    flex: 1;
  }

  .blog-card-date {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(42, 32, 27, 0.44);
  }

  .blog-card-title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .blog-card-title a {
    text-decoration: none;
    color: inherit;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .blog-card-title a:hover {
    color: rgba(42, 32, 27, 0.7);
  }

  .blog-card-desc {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.7;
    color: rgba(42, 32, 27, 0.65);
    margin: 0;
    flex: 1;
  }

  .blog-card-read {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-cafe);
    text-decoration: none;
    margin-top: auto;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .blog-card-read:hover {
    opacity: 0.7;
  }
</style>
