---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';
import { getWhatsAppLink } from '@/lib/whatsapp';

const waLink = getWhatsAppLink('contacto');

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Contacto', url: '/contacto' },
];
---

<BaseLayout
  title="Contacto — AntonyDev Zihuatanejo"
  description="Contáctame para cotizar tu proyecto de desarrollo web en Zihuatanejo. WhatsApp, correo o formulario. Respondo en menos de 24 horas — Antony Valdovinos, AntonyDev."
  breadcrumbs={breadcrumbs}
>
  <Header />
  <main>

    <section class="page-hero">
      <div class="page-container">
        <nav class="breadcrumb" aria-label="Navegación">
          <a href="/">Inicio</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Contacto</span>
        </nav>
        <h1>Hablemos sobre tu negocio</h1>
        <p class="page-lead">
          Cuéntame qué necesitas. Respondo en menos de 24 horas —
          o escríbeme directo por WhatsApp para respuesta inmediata.
        </p>
      </div>
    </section>

    <section class="contact-section">
      <div class="page-container contact-grid">

        <!-- Left — info + WhatsApp -->
        <div class="contact-info">
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="wa-primary">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.122 1.532 5.847L.057 23.882l6.196-1.453A11.954 11.954 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.816 9.816 0 01-5.015-1.374l-.36-.214-3.727.874.93-3.615-.234-.371A9.818 9.818 0 012.182 12C2.182 6.58 6.58 2.182 12 2.182S21.818 6.58 21.818 12 17.42 21.818 12 21.818z"/>
            </svg>
            <span>
              <strong>Escribir por WhatsApp</strong>
              <em>Respuesta inmediata</em>
            </span>
          </a>

          <div class="contact-details">
            <div class="contact-detail-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
              <a href="mailto:hola@antonydev.com">hola@antonydev.com</a>
            </div>
            <div class="contact-detail-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
              </svg>
              <span>Zihuatanejo, Guerrero, México</span>
            </div>
            <div class="contact-detail-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
              <span>Respondo en menos de 24 horas</span>
            </div>
          </div>

          <div class="services-list">
            <p class="services-list-label">¿En qué puedo ayudarte?</p>
            <ul>
              <li><a href="/servicios/auditoria">Auditoría digital gratuita</a></li>
              <li><a href="/servicios/creacion">Desarrollo de sitios web</a></li>
              <li><a href="/servicios/mantenimiento">Mantenimiento mensual</a></li>
              <li><a href="/servicios/identidad">Identidad digital</a></li>
              <li><a href="/servicios/automatizacion">Automatización y pagos</a></li>
            </ul>
          </div>
        </div>

        <!-- Right — form -->
        <div class="contact-form-wrap">
          <form id="contact-form" action="/api/contact" method="POST" class="contact-form" novalidate>

            <!-- Honeypot -->
            <div class="hp-field" aria-hidden="true">
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </div>

            <div class="form-row">
              <div class="form-field">
                <label for="contact-nombre" class="form-label">Nombre *</label>
                <input id="contact-nombre" type="text" name="nombre" placeholder="Tu nombre" class="form-input" required autocomplete="name" />
              </div>
              <div class="form-field">
                <label for="contact-whatsapp" class="form-label">WhatsApp *</label>
                <input id="contact-whatsapp" type="tel" name="whatsapp" placeholder="755 000 0000" class="form-input" required autocomplete="tel" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-field">
                <label for="contact-negocio" class="form-label">Nombre de tu negocio *</label>
                <input id="contact-negocio" type="text" name="negocio" placeholder="Tu restaurante, tienda..." class="form-input" required />
              </div>
              <div class="form-field">
                <label for="contact-email" class="form-label">Correo (opcional)</label>
                <input id="contact-email" type="email" name="email" placeholder="tu@correo.com" class="form-input" autocomplete="email" />
              </div>
            </div>

            <div class="form-field">
              <label for="contact-mensaje" class="form-label">¿Cómo puedo ayudarte? *</label>
              <textarea id="contact-mensaje" name="mensaje" placeholder="Cuéntame sobre tu negocio y lo que necesitas..." rows={5} class="form-textarea" required></textarea>
            </div>

            <div class="form-footer">
              <button type="submit" class="submit-btn">
                <span class="submit-label">Enviar mensaje</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                </svg>
              </button>
              <p class="form-note">Respondo en menos de 24 horas.</p>
            </div>

            <div id="form-feedback" class="form-feedback" aria-live="polite" hidden></div>
          </form>
        </div>

      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const feedback = document.getElementById('form-feedback') as HTMLElement | null;
  const submitBtn = form?.querySelector('.submit-btn') as HTMLButtonElement | null;
  const submitLabel = form?.querySelector('.submit-label') as HTMLElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || !submitLabel || !feedback) return;
    submitBtn.disabled = true;
    submitLabel.textContent = 'Enviando...';
    feedback.hidden = true;

    const data: Record<string, string> = {};
    new FormData(form).forEach((v, k) => { data[k] = v.toString(); });

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (res.ok) {
        form.reset();
        feedback.textContent = '¡Mensaje enviado! Te contactaré pronto.';
        feedback.className = 'form-feedback form-feedback--ok';
      } else {
        const json = await res.json().catch(() => ({}));
        feedback.textContent = (json as any).error ?? 'Algo salió mal. Intenta de nuevo.';
        feedback.className = 'form-feedback form-feedback--err';
      }
    } catch {
      feedback.textContent = 'Sin conexión. Por favor intenta más tarde.';
      feedback.className = 'form-feedback form-feedback--err';
    }
    feedback.hidden = false;
    submitBtn.disabled = false;
    submitLabel.textContent = 'Enviar mensaje';
  });
</script>

<style>
  .page-container { width: 100%; max-width: 1200px; margin-inline: auto; padding-inline: clamp(1rem, 5vw, 3rem); }
  .page-hero { background-color: var(--bg-surface); border-bottom: 1px solid var(--border); padding: clamp(3rem, 8vw, 6rem) 0 clamp(2.5rem, 6vw, 5rem); }
  .breadcrumb { display: flex; align-items: center; gap: 0.5rem; font-family: var(--font-body); font-size: 0.8125rem; color: rgba(42, 32, 27, 0.48); margin-bottom: var(--space-6); }
  .breadcrumb a { text-decoration: none; color: inherit; }
  .breadcrumb a:hover { color: var(--color-cafe); }
  .page-hero h1 { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); font-weight: 700; line-height: 1.1; letter-spacing: -0.03em; color: var(--text-primary); margin: 0 0 var(--space-6); }
  .page-lead { font-family: var(--font-body); font-size: 1.0625rem; line-height: 1.75; color: rgba(42, 32, 27, 0.68); max-width: 50ch; margin: 0; }

  /* ── Contact section ─────────────────────────────── */
  .contact-section { background-color: var(--bg-page); padding: clamp(4rem, 10vw, 7rem) 0; }
  .contact-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-16); align-items: start; }
  @media (min-width: 1024px) { .contact-grid { grid-template-columns: 1fr 1.2fr; gap: var(--space-24); } }

  /* ── WhatsApp primary ────────────────────────────── */
  .wa-primary {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    background-color: var(--color-cafe);
    color: var(--text-inverse);
    border-radius: var(--radius-button);
    padding: var(--space-4) var(--space-6);
    text-decoration: none;
    margin-bottom: var(--space-12);
    transition: background-color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out), transform var(--dur-fast) var(--ease-out);
    max-width: fit-content;
  }
  .wa-primary:hover { background-color: var(--color-cafe-negro); box-shadow: 0 4px 20px rgba(42, 32, 27, 0.18); transform: translateY(-1px); }
  @media (prefers-reduced-motion: reduce) { .wa-primary:hover { transform: none; } }
  .wa-primary svg { flex-shrink: 0; }
  .wa-primary span { display: flex; flex-direction: column; gap: 2px; }
  .wa-primary strong { font-family: var(--font-body); font-size: 0.9375rem; font-weight: 600; line-height: 1.2; }
  .wa-primary em { font-family: var(--font-body); font-size: 0.75rem; font-style: normal; opacity: 0.72; }

  /* ── Contact details ─────────────────────────────── */
  .contact-details { display: flex; flex-direction: column; gap: var(--space-4); margin-bottom: var(--space-12); }
  .contact-detail-item { display: flex; align-items: center; gap: var(--space-3); }
  .contact-detail-item svg { color: rgba(42, 32, 27, 0.5); flex-shrink: 0; }
  .contact-detail-item a, .contact-detail-item span { font-family: var(--font-body); font-size: 0.9375rem; color: rgba(42, 32, 27, 0.82); text-decoration: none; }
  .contact-detail-item a:hover { color: var(--color-cafe); }

  /* ── Services list ───────────────────────────────── */
  .services-list { border-top: 1px solid var(--border); padding-top: var(--space-8); }
  .services-list-label { font-family: var(--font-body); font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(42, 32, 27, 0.44); margin: 0 0 var(--space-4); }
  .services-list ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-3); }
  .services-list a { font-family: var(--font-body); font-size: 0.875rem; color: var(--color-cafe); text-decoration: none; transition: opacity var(--dur-fast) var(--ease-out); }
  .services-list a:hover { opacity: 0.72; }

  /* ── Form ────────────────────────────────────────── */
  .contact-form-wrap { background-color: transparent; }
  .contact-form { display: flex; flex-direction: column; gap: clamp(1.25rem, 2.5vw, 1.5rem); }
  .hp-field { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; opacity: 0; pointer-events: none; }
  .form-row { display: grid; grid-template-columns: 1fr; gap: clamp(1rem, 2vw, 1.25rem); }
  @media (min-width: 540px) { .form-row { grid-template-columns: 1fr 1fr; column-gap: clamp(1.125rem, 2.25vw, 1.5rem); } }
  .form-field { display: flex; flex-direction: column; gap: var(--space-2); }
  .form-label { font-family: var(--font-body); font-size: 0.8125rem; font-weight: 500; color: rgba(42, 32, 27, 0.7); letter-spacing: 0.01em; }
  .form-input, .form-textarea { font-family: var(--font-body); font-size: 0.9375rem; color: var(--text-primary); background-color: transparent; border: 1px solid rgba(42, 32, 27, 0.14); border-radius: var(--radius-sm); padding: 0.875rem 1rem; width: 100%; outline: 0; transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out); }
  .form-input:focus-visible, .form-textarea:focus-visible { outline: 2px solid rgba(42, 32, 27, 0.45); outline-offset: 2px; }
  .form-input::placeholder, .form-textarea::placeholder { color: rgba(42, 32, 27, 0.38); }
  .form-input:hover, .form-textarea:hover { border-color: rgba(42, 32, 27, 0.24); }
  .form-input:focus, .form-textarea:focus { border-color: rgba(42, 32, 27, 0.42); box-shadow: 0 0 0 3px rgba(42, 32, 27, 0.05); }
  .form-textarea { resize: vertical; min-height: 9rem; padding-top: 0.875rem; }
  .form-footer { display: flex; align-items: center; gap: var(--space-6); flex-wrap: wrap; }
  .submit-btn { display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-body); font-size: 0.9375rem; font-weight: 500; color: var(--text-inverse); background-color: var(--color-cafe); border: none; border-radius: var(--radius-button); padding: 0.9rem 1.5rem; cursor: pointer; letter-spacing: 0.01em; transition: background-color var(--dur-base) var(--ease-out), transform var(--dur-fast) var(--ease-out); }
  .submit-btn:hover { background-color: var(--color-cafe-negro); transform: translateY(-1px); }
  .submit-btn:active { transform: translateY(1px); transition-duration: 100ms; }
  .submit-btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
  @media (prefers-reduced-motion: reduce) { .submit-btn:hover, .submit-btn:active { transform: none; } }
  .form-note { font-family: var(--font-body); font-size: 0.8125rem; color: rgba(42, 32, 27, 0.48); margin: 0; }
  .form-feedback { font-family: var(--font-body); font-size: 0.875rem; padding: var(--space-4) var(--space-6); border-radius: var(--radius-sm); margin-top: var(--space-2); }
  .form-feedback:not([hidden]) { animation: feedback-appear 320ms var(--ease-premium) both; }
  @keyframes feedback-appear { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
  .form-feedback--ok { background-color: rgba(42, 32, 27, 0.06); color: rgba(42, 32, 27, 0.85); border: 1px solid rgba(42, 32, 27, 0.12); }
  .form-feedback--err { background-color: rgba(180, 40, 40, 0.06); color: rgba(140, 20, 20, 0.9); border: 1px solid rgba(180, 40, 40, 0.18); }
</style>
