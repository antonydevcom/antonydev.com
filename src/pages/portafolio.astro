    gap: var(--space-3);
    animation: pf-up 800ms var(--ease-premium) 500ms both;
  }

  /* ─── Hero CTAs ──────────────────────────────────────────── */

  .pf-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    border-radius: var(--radius-button);
    padding: 0.75rem 1.2rem;
    text-decoration: none;
    border: 1px solid transparent;
    transition:
      background-color var(--dur-base) var(--ease-out),
      border-color     var(--dur-base) var(--ease-out),
      box-shadow       var(--dur-slow) var(--ease-out),
      transform        var(--dur-fast) var(--ease-out);
  }

  .pf-btn:hover  { transform: translateY(-2px); }
  .pf-btn:active { transform: translateY(1px);  transition-duration: 80ms; }

  .pf-btn--primary {
    background-color: var(--color-cafe);
    color: var(--color-hueso);
    border-color: var(--color-cafe);
  }
  .pf-btn--primary:hover {
    background-color: var(--color-cafe-negro);
    border-color: var(--color-cafe-negro);
    box-shadow: var(--shadow-button);
  }

  .pf-btn--secondary {
    background-color: transparent;
    color: var(--color-cafe);
    border-color: var(--border);
  }
  .pf-btn--secondary:hover {
    background-color: var(--bg-surface);
    border-color: var(--border-hover);
    box-shadow: var(--shadow-sm);
  }

  .pf-btn--ghost {
    background-color: transparent;
    color: var(--color-cafe);
    border-color: transparent;
  }
  .pf-btn--ghost:hover {
    background-color: var(--fill-ghost);
    border-color: var(--border);
  }

  @media (prefers-reduced-motion: reduce) {
    .pf-btn:hover, .pf-btn:active { transform: none; }
  }

  /* ─── Hero media column ──────────────────────────────────── */

  .pf-hero-media {
    animation: pf-fade 1000ms var(--ease-premium) 160ms both;
