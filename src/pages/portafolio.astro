---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';
import Container from '@/components/ui/Container.astro';
import { LOCATION, BRAND } from '@/lib/location';
import { getWhatsAppLink } from '@/lib/whatsapp';

const waLink = getWhatsAppLink('portafolio');

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Portafolio', url: '/portafolio' },
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${BRAND.siteUrl}/#person`,
  'name': BRAND.legalName,
  'alternateName': 'AntonyDev',
  'jobTitle': 'Desarrollador Web Fullstack',
  'url': `${BRAND.siteUrl}/portafolio`,
  'email': LOCATION.email,
  'telephone': LOCATION.phone,
  'sameAs': BRAND.sameAs,
  'knowsAbout': BRAND.knowsAbout,
};

const experience = [
  {
    period: '2019 – 2022',
    title: 'Industria de Servicios',
    body: 'Aprendí a trabajar bajo presión, resolver problemas rápidamente y brindar un excelente servicio al cliente en todo tipo de situaciones.',
    tag: 'Habilidades clave',
    skills: ['Comunicación', 'Resolución de problemas', 'Liderazgo', 'Trabajo en equipo'],
  },
  {
    period: '2022 – 2023',
    title: 'Formación en Desarrollo de Software',
    body: 'Comencé mi camino en la programación y el desarrollo web, construyendo proyectos personales y académicos con foco en lógica y estructuras sólidas.',
