// Brand colors for cert icons — intentionally not design tokens (external brand representation)
const certs = [
  { bg: '#3D8B37', initials: 'SF', title: 'Java Spring Framework', subtitle: 'Spring Framework 6 & Spring Boot 3' },
  { bg: '#3D8B37', initials: 'SS', title: 'Java Spring Security',   subtitle: 'Autenticación y Seguridad Web' },
  { bg: '#DD0031', initials: 'NG', title: 'Angular',                 subtitle: 'Desarrollo de aplicaciones web' },
