    skills: ['Lógica', 'Algoritmos', 'Estructuras de datos', 'Desarrollo web', 'Bases sólidas'],
  },
  {
    period: '2023 – Actualidad',
    title: 'Desarrollador Fullstack',
    body: 'Desarrollo aplicaciones y sistemas completos usando tecnologías modernas, siempre enfocado en la calidad y el usuario final.',
