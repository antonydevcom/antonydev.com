---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';
import { getWhatsAppLink } from '@/lib/whatsapp';

const waLink = getWhatsAppLink('auditoria');

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Servicios', url: '/servicios' },
  { name: 'Auditoría', url: '/servicios/auditoria' },
];

const faqs = [
  {
    q: '¿La auditoría realmente es gratuita?',
    a: 'Sí. Para nuevos clientes la auditoría inicial es completamente gratuita y sin compromiso. Incluye revisión de tu presencia digital actual, análisis de competencia local y un reporte con recomendaciones concretas.',
  },
  {
    q: '¿Cuánto tiempo toma la auditoría?',
    a: 'Entre 3 y 5 días hábiles desde la primera conversación. Te entrego el reporte por escrito junto con una videollamada para explicarte los resultados.',
  },
  {
    q: '¿Qué pasa si ya tengo un sitio web?',
    a: 'Lo revisamos a fondo — velocidad, SEO, estructura, contenido, competencia local. Muchos negocios descubren problemas que llevaban años afectando su visibilidad en Google sin saberlo.',
  },
  {
    q: '¿Es necesario contratar algo después de la auditoría?',
    a: 'No. El reporte es tuyo sin condición. Puedes implementar las recomendaciones por tu cuenta, con otro proveedor o conmigo. La auditoría existe para darte claridad, no para presionarte.',
  },
  {
    q: '¿Haces auditorías para negocios fuera de Zihuatanejo?',
    a: 'Sí, trabajo con negocios en todo México de forma remota. Tengo experiencia especial con negocios de Zihuatanejo, Ixtapa y la Costa de Guerrero.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(({ q, a }) => ({
    '@type': 'Question',
    'name': q,
    'acceptedAnswer': { '@type': 'Answer', 'text': a },
  })),
};
---

<BaseLayout
  title="Auditoría Digital para Negocios en Zihuatanejo e Ixtapa"
  description="Diagnóstico digital gratuito para tu negocio en Zihuatanejo. Revisión de presencia online, SEO local y competencia. Entrega en 3-5 días — Antony Valdovinos, AntonyDev."
  schema={faqSchema}
  breadcrumbs={breadcrumbs}
>
  <Header />
  <main>

    <!-- Hero -->
    <section class="page-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Navegación">
          <a href="/">Inicio</a>
          <span aria-hidden="true">/</span>
          <a href="/servicios">Servicios</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Auditoría</span>
        </nav>
        <p class="phase-badge">Fase 1</p>
        <h1>Auditoría digital para tu negocio</h1>
        <p class="page-lead">
          El punto de partida para cualquier negocio que quiere crecer en línea.
          Identifico exactamente qué necesitas y por qué, sin rodeos.
        </p>
        <div class="hero-cta-row">
          <p class="price-badge">Gratis para nuevos clientes</p>
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="wa-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.122 1.532 5.847L.057 23.882l6.196-1.453A11.954 11.954 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.816 9.816 0 01-5.015-1.374l-.36-.214-3.727.874.93-3.615-.234-.371A9.818 9.818 0 012.182 12C2.182 6.58 6.58 2.182 12 2.182S21.818 6.58 21.818 12 17.42 21.818 12 21.818z"/>
            </svg>
            Solicitar mi auditoría gratuita
          </a>
        </div>
      </div>
    </section>

    <!-- Qué incluye -->
    <section class="content-section">
      <div class="container content-grid">
        <div class="content-body">
          <h2>¿Qué incluye la auditoría?</h2>
          <p>
            La auditoría digital es un diagnóstico completo de tu negocio en línea.
            Reviso cada punto de contacto digital que tus clientes potenciales
            pueden encontrar — desde tu sitio web hasta tu perfil en Google Maps.
          </p>

          <ul class="includes-list">
            <li>
              <strong>Análisis de presencia digital actual</strong>
              — sitio web, redes sociales, Google Business Profile y directorios locales.
            </li>
            <li>
              <strong>Diagnóstico de SEO local</strong>
              — qué tan fácil te encuentran en Google cuando alguien busca tus servicios en Zihuatanejo o Ixtapa.
            </li>
            <li>
              <strong>Análisis de competencia</strong>
              — quiénes aparecen antes que tú y por qué.
            </li>
            <li>
              <strong>Revisión técnica</strong>
              — velocidad de carga, experiencia móvil, seguridad y Core Web Vitals.
            </li>
            <li>
              <strong>Reporte de oportunidades</strong>
              — listado concreto de qué hacer primero, qué puede esperar y cuánto podría costar.
            </li>
          </ul>

          <h2>¿Para qué tipo de negocios es?</h2>
          <p>
            La auditoría es útil para cualquier negocio en Zihuatanejo, Ixtapa y la Costa de Guerrero
            que quiera entender su situación digital actual. He trabajado con:
          </p>
          <ul class="business-list">
            <li>Restaurantes y marisquerías</li>
            <li>Agencias de bienes raíces en Ixtapa</li>
            <li>Hoteles boutique y rentas vacacionales</li>
            <li>Mueblerías y comercios locales</li>
            <li>Barbería, salones de belleza y servicios personales</li>
            <li>Servicios profesionales (médicos, abogados, contadores)</li>
            <li>Tour operadores y actividades turísticas</li>
          </ul>

          <h2>¿Cómo funciona el proceso?</h2>
          <ol class="process-list">
            <li>
              <strong>Conversación inicial (30 min)</strong>
              — me cuentas sobre tu negocio, tus objetivos y tus retos actuales.
            </li>
            <li>
              <strong>Análisis (3-5 días hábiles)</strong>
              — reviso a fondo tu presencia digital y la de tus competidores locales.
            </li>
            <li>
              <strong>Entrega del reporte</strong>
              — documento escrito + videollamada para explicarte cada punto.
            </li>
            <li>
              <strong>Plan de acción</strong>
              — si decides seguir trabajando juntos, diseñamos el camino más efectivo.
            </li>
          </ol>
        </div>

        <!-- Sidebar -->
        <aside class="sidebar">
          <div class="sidebar-card">
            <h3>Datos clave</h3>
            <dl class="sidebar-dl">
              <dt>Costo</dt>
              <dd>Gratuito para nuevos clientes</dd>
              <dt>Tiempo de entrega</dt>
              <dd>3-5 días hábiles</dd>
              <dt>Formato</dt>
              <dd>Reporte escrito + videollamada</dd>
              <dt>Compromiso</dt>
              <dd>Ninguno — el reporte es tuyo</dd>
            </dl>
            <a href={waLink} target="_blank" rel="noopener noreferrer" class="sidebar-cta">
              Solicitar auditoría
            </a>
          </div>

          <div class="sidebar-related">
            <p class="related-label">Siguiente paso</p>
            <a href="/servicios/creacion" class="related-link">
              Creación de sistemas →
            </a>
            <a href="/servicios" class="related-link">
              Ver todos los servicios →
            </a>
          </div>
        </aside>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section">
      <div class="container">
        <h2>Preguntas frecuentes</h2>
        <dl class="faq-list">
          {faqs.map(({ q, a }) => (
            <div class="faq-item">
              <dt class="faq-q">{q}</dt>
              <dd class="faq-a">{a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
