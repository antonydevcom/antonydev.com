---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';
import { getWhatsAppLink } from '@/lib/whatsapp';

const waLink = getWhatsAppLink('automatizacion');

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Servicios', url: '/servicios' },
  { name: 'Automatización', url: '/servicios/automatizacion' },
];

const faqs = [
  {
    q: '¿Qué es un WhatsApp automatizado?',
    a: 'Es un sistema que conecta tu sitio web con WhatsApp Business de forma que cuando alguien llena un formulario o hace clic en un botón, recibe un mensaje personalizado de tu número de WhatsApp. Tú ves el chat y puedes continuar la conversación.',
  },
  {
    q: '¿Puedo aceptar pagos en mi sitio con MercadoPago?',
    a: 'Sí. Integro MercadoPago Checkout Pro para aceptar tarjetas, OXXO y transferencias SPEI. Es la opción más usada para negocios mexicanos porque cubre los métodos de pago que tus clientes locales ya usan.',
  },
  {
    q: '¿Qué tipo de negocios se benefician más de la automatización?',
    a: 'Restaurantes (menú digital, pedidos), agencias inmobiliarias (catálogos de propiedades), hoteles y rentas vacacionales (sistemas de reservas), comercios (tiendas en línea), y cualquier negocio que reciba preguntas repetitivas por WhatsApp.',
  },
  {
    q: '¿La automatización funciona sin tener un sitio web nuevo?',
    a: 'Algunos elementos sí, como la integración de WhatsApp en un sitio existente. Pero para resultados óptimos, la automatización se implementa mejor como parte del sistema digital completo.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(({ q, a }) => ({
    '@type': 'Question',
    'name': q,
    'acceptedAnswer': { '@type': 'Answer', 'text': a },
  })),
};
---

<BaseLayout
  title="Automatización y Pagos en Línea para Negocios en Ixtapa y Zihuatanejo"
  description="WhatsApp automatizado, pagos en línea con MercadoPago y sistemas de reservas para negocios en Ixtapa, Zihuatanejo y Guerrero. Antony Valdovinos — AntonyDev."
  schema={faqSchema}
  breadcrumbs={breadcrumbs}
>
  <Header />
  <main>

    <section class="page-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Navegación">
          <a href="/">Inicio</a><span aria-hidden="true">/</span>
          <a href="/servicios">Servicios</a><span aria-hidden="true">/</span>
          <span aria-current="page">Automatización</span>
        </nav>
        <h1>Automatización y pagos en línea</h1>
        <p class="page-lead">
          WhatsApp automatizado, pagos con MercadoPago, catálogos digitales y sistemas
          de reservas — para que tu negocio trabaje aunque tú no estés en la pantalla.
        </p>
        <a href={waLink} target="_blank" rel="noopener noreferrer" class="wa-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.122 1.532 5.847L.057 23.882l6.196-1.453A11.954 11.954 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.816 9.816 0 01-5.015-1.374l-.36-.214-3.727.874.93-3.615-.234-.371A9.818 9.818 0 012.182 12C2.182 6.58 6.58 2.182 12 2.182S21.818 6.58 21.818 12 17.42 21.818 12 21.818z"/>
          </svg>
          Cotizar automatización
        </a>
      </div>
    </section>

    <section class="content-section">
      <div class="container content-grid">
        <div class="content-body">
          <h2>WhatsApp automatizado para negocios locales</h2>
          <p>
            La mayoría de los clientes en Zihuatanejo e Ixtapa prefieren escribir
            por WhatsApp antes que llamar o llenar un formulario. El problema es
            que responder manualmente a cada mensaje consume horas.
          </p>
          <p>
            Con WhatsApp automatizado, cada cliente que visita tu sitio y hace
            clic en el botón de contacto inicia una conversación con un mensaje
            contextual — según la página donde está y lo que está buscando.
            Tú solo cierras la venta.
          </p>

          <h2>Pagos en línea con MercadoPago</h2>
          <p>
            Integro MercadoPago Checkout Pro directamente en tu sitio web.
            Tus clientes pueden pagar con:
          </p>
          <ul class="includes-list">
            <li>Tarjeta de crédito y débito (Visa, Mastercard, American Express)</li>
            <li>OXXO — el método favorito de los clientes sin tarjeta</li>
            <li>Transferencia SPEI — para montos mayores</li>
            <li>Meses sin intereses según el banco del cliente</li>
          </ul>

          <h2>Sistemas de reservas y catálogos digitales</h2>
          <p>
            Para hoteles, rentas vacacionales, restaurantes y comercios, desarrollo
            sistemas específicos para su operación:
          </p>
          <ul class="includes-list">
            <li>Calendario de disponibilidad y reservas en línea para villas y hoteles en Ixtapa</li>
            <li>Menú digital con QR para restaurantes en Zihuatanejo</li>
            <li>Catálogo de productos con fotos y precios actualizables</li>
            <li>Sistema de citas para servicios personales (estética, médicos, etc.)</li>
          </ul>
        </div>

        <aside class="sidebar">
          <div class="sidebar-card">
            <h3>Automatización</h3>
            <dl class="sidebar-dl">
              <dt>WhatsApp</dt>
              <dd>Mensajes contextuales automáticos</dd>
              <dt>Pagos</dt>
              <dd>MercadoPago / Stripe</dd>
              <dt>Catálogos</dt>
              <dd>Productos, servicios, menús</dd>
              <dt>Reservas</dt>
              <dd>Calendario + confirmación automática</dd>
            </dl>
            <a href={waLink} target="_blank" rel="noopener noreferrer" class="sidebar-cta">
              Solicitar cotización
            </a>
          </div>
          <div class="sidebar-related">
            <p class="related-label">Servicios relacionados</p>
            <a href="/servicios/creacion" class="related-link">← Desarrollo web</a>
            <a href="/servicios/mantenimiento" class="related-link">Mantenimiento →</a>
          </div>
        </aside>
      </div>
    </section>

    <section class="faq-section">
      <div class="container">
        <h2>Preguntas frecuentes sobre automatización</h2>
        <dl class="faq-list">
          {faqs.map(({ q, a }) => (
            <div class="faq-item">
              <dt class="faq-q">{q}</dt>
              <dd class="faq-a">{a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
  /* automatizacion: longer h1 and wider lead than other service pages */
  .page-hero h1 { max-width: 24ch; }
  .page-lead { max-width: 52ch; margin-bottom: var(--space-8); }
</style>
