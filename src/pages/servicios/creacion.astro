---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';
import { getWhatsAppLink } from '@/lib/whatsapp';
import { PageHeading } from '@/components/motion/PageHeading';
import WhatsAppIcon from '@/components/ui/WhatsAppIcon.astro';

const waLink = getWhatsAppLink('creacion');

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Servicios', url: '/servicios' },
  { name: 'Creación', url: '/servicios/creacion' },
];

const includes = [
  'Sitio web o sistema a medida (Astro, React según el proyecto)',
  'Diseño con identidad visual personalizada — paleta, tipografía, tono',
  'SEO local desde el primer día — Google indexa tu negocio desde el lanzamiento',
  'WhatsApp automatizado para capturar clientes desde el sitio',
  'Formulario de contacto con notificaciones por correo',
  'Responsive — funciona perfecto en teléfono, tablet y computadora',
  'Velocidad de carga optimizada — LCP < 1.5s garantizado',
  'Soporte técnico durante el mes de lanzamiento',
];

const faqs = [
  {
    q: '¿Cuánto tiempo tarda el desarrollo?',
    a: 'Entre 2 y 4 semanas según la complejidad. Un sitio landing con 4-6 secciones tarda 2 semanas. Un sistema de gestión completo puede tomar 3-4 semanas.',
  },
  {
    q: '¿Qué necesito tener listo antes de empezar?',
    a: 'Solo tu número de WhatsApp y el nombre de tu negocio. El logo, textos y fotografías los desarrollamos juntos durante el proyecto si aún no los tienes.',
  },
  {
    q: '¿Puedo agregar más secciones después?',
    a: 'Sí. El sitio se entrega pensado para crecer. Las modificaciones y nuevas secciones se manejan en el plan de Mantenimiento Mensual.',
  },
  {
    q: '¿El sitio incluye dominio y hosting?',
    a: 'El dominio (.com.mx suele costar $150-300 MXN/año) y el hosting se configuran durante el proyecto. Los costos de dominio y hosting los cubre el cliente directamente a los proveedores.',
  },
  {
    q: '¿Haces e-commerce y tiendas en línea?',
    a: 'Sí. Los proyectos de e-commerce tienen un costo diferente y se cotizan según el número de productos, integraciones de pago y funcionalidades requeridas.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(({ q, a }) => ({
    '@type': 'Question',
    'name': q,
    'acceptedAnswer': { '@type': 'Answer', 'text': a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://antonydev.com/servicios/creacion#service',
  'name': 'Desarrollo de Sitios Web y Sistemas Digitales',
  'description': 'Diseño y desarrollo de sitios web y sistemas a medida para negocios en Zihuatanejo e Ixtapa. Incluye SEO local, identidad visual, WhatsApp automatizado y formularios. Desde $6,000 MXN.',
  'provider': { '@id': 'https://antonydev.com/#business' },
  'areaServed': ['Zihuatanejo', 'Ixtapa', 'Guerrero', 'México'],
  'url': 'https://antonydev.com/servicios/creacion',
  'serviceType': 'Web Development',
  'offers': {
    '@type': 'Offer',
    'price': '6000',
    'priceCurrency': 'MXN',
    'description': 'Sitio web o sistema a medida desde $6,000 MXN. Incluye SEO, diseño y WhatsApp.',
  },
};
---

<BaseLayout
  title="Desarrollo Web en Zihuatanejo e Ixtapa"
  description="Sitios web y sistemas digitales para negocios en Zihuatanejo. SEO local, WhatsApp automatizado e identidad visual. Desde $6,000 MXN — AntonyDev."
  schema={[faqSchema, serviceSchema]}
  breadcrumbs={breadcrumbs}
>
  <Header />
  <main>

    <section class="page-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Navegación">
          <a href="/">Inicio</a><span aria-hidden="true">/</span>
          <a href="/servicios">Servicios</a><span aria-hidden="true">/</span>
          <span aria-current="page">Creación</span>
        </nav>
        <p class="phase-badge">Fase 2</p>
        <PageHeading text="Desarrollo de sitios web en Zihuatanejo e Ixtapa" client:load />
        <p class="page-lead">
          Tu presencia digital completa — sitio web, identidad visual, WhatsApp
          automatizado y SEO local, todo integrado y funcionando desde el primer día.
        </p>
        <div class="hero-cta-row">
          <p class="price-badge">Desde $6,000 MXN</p>
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="wa-btn">
            <WhatsAppIcon />
            Cotizar mi proyecto
          </a>
        </div>
      </div>
    </section>

    <section class="content-section">
      <div class="container content-grid">
        <div class="content-body">
          <h2>¿Qué incluye el servicio de creación?</h2>
          <p>
            Un sitio web que no genera clientes no está terminado. Todos mis proyectos
            incluyen SEO técnico, WhatsApp automatizado e identidad visual para que
            tu negocio en Zihuatanejo o Ixtapa aparezca en Google y convierta visitas.
          </p>
          <ul class="includes-list">
            {includes.map((item) => <li>{item}</li>)}
          </ul>

          <h2>¿Para qué tipo de proyectos aplica?</h2>
          <p>
            Trabajo con negocios locales de todo tipo. Algunos proyectos recientes:
          </p>
          <ul class="business-list">
            <li>Landing page para negocio de turismo en Ixtapa</li>
            <li>Sistema de gestión de cotizaciones para mueblería local</li>
            <li>Sitio con catálogo digital para joyería en Zihuatanejo</li>
            <li>Página web con agenda en línea para clínica de estética</li>
            <li>Tienda en línea para negocio de productos artesanales</li>
          </ul>

          <h2>¿Por qué el SEO local importa desde el inicio?</h2>
          <p>
            La mayoría de los sitios web en Zihuatanejo e Ixtapa se construyen
            sin pensar en SEO. Google no los indexa bien, y los clientes que
            buscan en línea no los encuentran, aunque el negocio lleve años abierto.
          </p>
          <p>
            Todos mis proyectos incluyen SEO técnico desde el primer día:
            metadatos correctos, schema estructurado, sitemap, velocidad
            optimizada y contenido orientado a las búsquedas locales.
          </p>
        </div>

        <aside class="sidebar">
          <div class="sidebar-card">
            <h3>Inversión</h3>
            <dl class="sidebar-dl">
              <dt>Precio base</dt>
              <dd>Desde $6,000 MXN</dd>
              <dt>Tiempo entrega</dt>
              <dd>2-4 semanas</dd>
              <dt>Incluye</dt>
              <dd>Diseño + desarrollo + SEO + WhatsApp</dd>
              <dt>Soporte</dt>
              <dd>1 mes post-lanzamiento</dd>
            </dl>
            <a href={waLink} target="_blank" rel="noopener noreferrer" class="sidebar-cta">
              Cotizar proyecto
            </a>
          </div>
          <div class="sidebar-related">
            <p class="related-label">Servicios relacionados</p>
            <a href="/servicios/auditoria" class="related-link">← Auditoría gratuita primero</a>
            <a href="/servicios/mantenimiento" class="related-link">Mantenimiento mensual →</a>
            <a href="/servicios/identidad" class="related-link">Identidad digital →</a>
          </div>
        </aside>
      </div>
    </section>

    <section class="faq-section">
      <div class="container">
        <h2>Preguntas frecuentes sobre el desarrollo web</h2>
        <dl class="faq-list">
          {faqs.map(({ q, a }) => (
            <div class="faq-item">
              <dt class="faq-q">{q}</dt>
              <dd class="faq-a">{a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
