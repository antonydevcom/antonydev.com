---
import '@/styles/service-cards.css';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';
import WhatsAppIcon from '@/components/ui/WhatsAppIcon.astro';
import { ServiceCards } from '@/components/motion/ServiceCards';
import { SectionHeaderReveal } from '@/components/motion/SectionHeaderReveal';
import { SectionReveal } from '@/components/motion/SectionReveal';
import { PageHeading } from '@/components/motion/PageHeading';
import { getWhatsAppLink } from '@/lib/whatsapp';

const waLink = getWhatsAppLink('servicios');

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Servicios', url: '/servicios' },
];

const serviceListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': 'Servicios de Desarrollo Web — AntonyDev Zihuatanejo',
  'description': 'Desarrollo web, identidad digital, automatización y mantenimiento para negocios en Zihuatanejo e Ixtapa.',
  'url': 'https://antonydev.com/servicios',
  'numberOfItems': 5,
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'url': 'https://antonydev.com/servicios/auditoria', 'name': 'Auditoría Digital' },
    { '@type': 'ListItem', 'position': 2, 'url': 'https://antonydev.com/servicios/creacion', 'name': 'Desarrollo Web' },
    { '@type': 'ListItem', 'position': 3, 'url': 'https://antonydev.com/servicios/mantenimiento', 'name': 'Mantenimiento Web' },
    { '@type': 'ListItem', 'position': 4, 'url': 'https://antonydev.com/servicios/identidad', 'name': 'Identidad Digital' },
    { '@type': 'ListItem', 'position': 5, 'url': 'https://antonydev.com/servicios/automatizacion', 'name': 'Automatización y Pagos' },
  ],
};

const phases = [
  {
    number: '01',
    label: 'El punto de partida',
    title: 'Auditoría Digital',
    description: 'Diagnóstico completo de tu presencia digital. Identifico qué falta, qué funciona y cuál es el camino más directo para crecer en línea.',
    detail: 'Gratis para nuevos clientes',
    href: '/servicios/auditoria',
  },
  {
    number: '02',
    label: 'Tu presencia digital completa',
    title: 'Creación de Sistemas',
    description: 'Sitio web, sistema de gestión, identidad visual, WhatsApp automatizado y SEO local — todo integrado desde el primer día.',
    detail: 'Desde $6,000 MXN',
    href: '/servicios/creacion',
  },
  {
    number: '03',
    label: 'Crecimiento continuo',
    title: 'Mantenimiento Mensual',
    description: 'Actualizaciones, soporte técnico, nuevas secciones y respaldo. Tu negocio siempre al día y funcionando sin interrupciones.',
    detail: 'Desde $700 MXN/mes',
    href: '/servicios/mantenimiento',
  },
];

const extras = [
  {
    title: 'Identidad Digital',
    description: 'Paleta de colores, tipografía, tono de voz e imagen coherente para tu negocio.',
    href: '/servicios/identidad',
  },
  {
    title: 'Automatización',
    description: 'WhatsApp Business automatizado, pagos en línea, catálogos digitales y sistemas de reservas.',
    href: '/servicios/automatizacion',
  },
];
---

<BaseLayout
  title="Servicios Web en Zihuatanejo"
  description="Desarrollo web, identidad digital, automatización y mantenimiento para negocios en Zihuatanejo e Ixtapa. Auditoría gratuita — Antony Valdovinos, AntonyDev."
  schema={serviceListSchema}
  breadcrumbs={breadcrumbs}
>
  <Header />
  <main>

    <!-- Hero -->
    <section class="page-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Navegación">
          <a href="/">Inicio</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Servicios</span>
        </nav>
        <PageHeading text="Desarrollo web, sistemas e identidad digital" style={{ fontSize: 'clamp(2rem, 4vw, 3rem)', lineHeight: '1.1', maxWidth: '18ch' }} client:load />
        <p class="page-lead" data-reveal data-reveal-delay="120">
          Un modelo de trabajo completo — desde el diagnóstico inicial hasta el
          crecimiento continuo de tu presencia digital.
        </p>
      </div>
    </section>

    <!-- Fases + adicionales — mismo island que el home (Motion, spotlight, borde) -->
    <section class="servicios-showcase">
      <div class="container">
        <SectionHeaderReveal
          eyebrow="El ciclo completo"
          heading="Las 3 fases del trabajo"
          showDivider={false}
          client:visible
        />
        <ServiceCards
          client:visible
          phases={phases}
          extras={extras}
          extrasLabel="Servicios adicionales"
          extraLinkLabel="Ver servicio"
        />
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <div class="container cta-inner">
        <SectionReveal client:visible>
          <div>
            <h2>¿Por dónde empezamos?</h2>
            <p>La auditoría es gratuita y sin compromiso. Platiquemos sobre tu negocio.</p>
          </div>
        </SectionReveal>
        <a href={waLink} target="_blank" rel="noopener noreferrer" class="wa-btn" data-cursor="premium">
          <WhatsAppIcon size={20} />
          Solicitar auditoría gratuita
        </a>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
  .page-lead { margin: 0; }

  .servicios-showcase {
    background-color: var(--bg-page);
    padding: clamp(4rem, 10vw, 7rem) 0;
    border-bottom: 1px solid var(--border);
  }


  /* ── CTA section ─────────────────────────────────── */
  .cta-section {
    background-color: var(--bg-dark);
    padding: clamp(3.5rem, 8vw, 6rem) 0;
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    align-items: flex-start;
  }

  @media (max-width: 560px) {
    .cta-inner .wa-btn {
      width: 100%;
      justify-content: center;
    }
  }

  @media (min-width: 768px) {
    .cta-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .cta-section h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--text-inverse);
    margin: 0 0 var(--space-3);
  }

  .cta-section p {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: rgba(247, 244, 238, 0.65);
    margin: 0;
    max-width: 44ch;
  }

  /* inverted wa-btn — light on dark CTA section */
  .wa-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-cafe-negro);
    background-color: var(--color-hueso);
    border-radius: var(--radius-button);
    padding: 0.9rem 1.5rem;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition:
      background-color var(--dur-base) var(--ease-out),
      box-shadow       var(--dur-slow) var(--ease-out),
      transform        var(--dur-fast) var(--ease-out);
  }

  .wa-btn svg { flex-shrink: 0; transition: transform var(--dur-base) var(--ease-out); }

  .wa-btn:hover {
    background-color: var(--color-marfil);
    box-shadow: var(--shadow-button);
    transform: translateY(-2px);
  }

  .wa-btn:hover svg { transform: translateY(-1px) scale(1.06); }

  @media (prefers-reduced-motion: reduce) {
    .wa-btn:hover, .wa-btn:hover svg { transform: none; }
  }

</style>

<style is:global>
  /* SectionHeaderReveal inside .servicios-showcase — React island, no scoped attrs */
  .servicios-showcase .section-header {
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .servicios-showcase .section-header h2 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }
</style>
