---
import '@/styles/service-cards.css';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';
import { ServiceCards } from '@/components/motion/ServiceCards';
import { getWhatsAppLink } from '@/lib/whatsapp';

const waLink = getWhatsAppLink('servicios');

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Servicios', url: '/servicios' },
];

const phases = [
  {
    number: '01',
    label: 'El punto de partida',
    title: 'Auditoría Digital',
    description: 'Diagnóstico completo de tu presencia digital. Identifico qué falta, qué funciona y cuál es el camino más directo para crecer en línea.',
    detail: 'Gratis para nuevos clientes',
    href: '/servicios/auditoria',
  },
  {
    number: '02',
    label: 'Tu presencia digital completa',
    title: 'Creación de Sistemas',
    description: 'Sitio web, sistema de gestión, identidad visual, WhatsApp automatizado y SEO local — todo integrado desde el primer día.',
    detail: 'Desde $18,000 MXN',
    href: '/servicios/creacion',
  },
  {
    number: '03',
    label: 'Crecimiento continuo',
    title: 'Mantenimiento Mensual',
    description: 'Actualizaciones, soporte técnico, nuevas secciones y respaldo. Tu negocio siempre al día y funcionando sin interrupciones.',
    detail: 'Desde $700 MXN/mes',
    href: '/servicios/mantenimiento',
  },
];

const extras = [
  {
    title: 'Identidad Digital',
    description: 'Paleta de colores, tipografía, tono de voz e imagen coherente para tu negocio.',
    href: '/servicios/identidad',
  },
  {
    title: 'Automatización',
    description: 'WhatsApp Business automatizado, pagos en línea, catálogos digitales y sistemas de reservas.',
    href: '/servicios/automatizacion',
  },
];
---

<BaseLayout
  title="Servicios de Desarrollo Web en Zihuatanejo"
  description="Desarrollo web, identidad digital, automatización y mantenimiento para negocios en Zihuatanejo e Ixtapa. Auditoría gratuita — Antony Valdovinos, AntonyDev."
  breadcrumbs={breadcrumbs}
>
  <Header />
  <main>

    <!-- Hero -->
    <section class="page-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Navegación">
          <a href="/">Inicio</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Servicios</span>
        </nav>
        <h1 data-reveal data-reveal-delay="0">Desarrollo web, sistemas e identidad digital</h1>
        <p class="page-lead" data-reveal data-reveal-delay="120">
          Un modelo de trabajo completo — desde el diagnóstico inicial hasta el
          crecimiento continuo de tu presencia digital.
        </p>
      </div>
    </section>

    <!-- Fases + adicionales — mismo island que el home (Motion, spotlight, borde) -->
    <section class="servicios-showcase">
      <div class="container">
        <p class="eyebrow" data-reveal data-reveal-delay="0">El ciclo completo</p>
        <h2 data-reveal data-reveal-delay="80">Las 3 fases del trabajo</h2>
        <ServiceCards
          client:visible
          phases={phases}
          extras={extras}
          extrasLabel="Servicios adicionales"
          extraLinkLabel="Ver servicio"
        />
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <div class="container cta-inner">
        <div>
          <h2 data-reveal data-reveal-delay="0">¿Por dónde empezamos?</h2>
          <p data-reveal data-reveal-delay="100">La auditoría es gratuita y sin compromiso. Platiquemos sobre tu negocio.</p>
        </div>
        <a href={waLink} target="_blank" rel="noopener noreferrer" class="wa-btn" data-cursor="premium">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.122 1.532 5.847L.057 23.882l6.196-1.453A11.954 11.954 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.816 9.816 0 01-5.015-1.374l-.36-.214-3.727.874.93-3.615-.234-.371A9.818 9.818 0 012.182 12C2.182 6.58 6.58 2.182 12 2.182S21.818 6.58 21.818 12 17.42 21.818 12 21.818z"/>
          </svg>
          Solicitar auditoría gratuita
        </a>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
  /* servicios/index: larger hero h1 than service detail pages, no lead margin */
  .page-hero h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
    max-width: 18ch;
  }

  .page-lead { margin: 0; }

  .servicios-showcase {
    background-color: var(--bg-page);
    padding: clamp(4rem, 10vw, 7rem) 0;
    border-bottom: 1px solid var(--border);
  }

  .servicios-showcase .eyebrow {
    margin-bottom: var(--space-4);
  }

  .servicios-showcase h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin: 0 0 var(--space-12);
  }

  /* ── CTA section ─────────────────────────────────── */
  .cta-section {
    background-color: var(--bg-dark);
    padding: clamp(3.5rem, 8vw, 6rem) 0;
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .cta-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .cta-section h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--text-inverse);
    margin: 0 0 var(--space-3);
  }

  .cta-section p {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: rgba(247, 244, 238, 0.65);
    margin: 0;
    max-width: 44ch;
  }

  /* inverted wa-btn — light on dark CTA section */
  .wa-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-cafe-negro);
    background-color: var(--color-hueso);
    border-radius: var(--radius-button);
    padding: 0.9rem 1.5rem;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition:
      background-color var(--dur-base) var(--ease-out),
      box-shadow       var(--dur-slow) var(--ease-out),
      transform        var(--dur-fast) var(--ease-out);
  }

  .wa-btn svg { flex-shrink: 0; transition: transform var(--dur-base) var(--ease-out); }

  .wa-btn:hover {
    background-color: var(--color-marfil);
    box-shadow: var(--shadow-button);
    transform: translateY(-2px);
  }

  .wa-btn:hover svg { transform: translateY(-1px) scale(1.06); }

  @media (prefers-reduced-motion: reduce) {
    .wa-btn:hover, .wa-btn:hover svg { transform: none; }
  }

  /* ── Scroll reveal ───────────────────────────────── */
  [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity   0.62s var(--ease-out),
      transform 0.62s var(--ease-out);
    transition-delay: var(--reveal-delay, 0ms);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const delay = (entry.target as HTMLElement).dataset.revealDelay ?? '0';
          (entry.target as HTMLElement).style.setProperty('--reveal-delay', delay + 'ms');
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { rootMargin: '0px 0px -48px 0px', threshold: 0.08 }
  );

  document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
</script>
