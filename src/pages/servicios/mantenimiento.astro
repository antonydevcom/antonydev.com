---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/sections/Header.astro';
import Footer from '@/components/sections/Footer.astro';
import { getWhatsAppLink } from '@/lib/whatsapp';
import { PageHeading } from '@/components/motion/PageHeading';
import WhatsAppIcon from '@/components/ui/WhatsAppIcon.astro';

const waLink = getWhatsAppLink('mantenimiento');

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Servicios', url: '/servicios' },
  { name: 'Mantenimiento', url: '/servicios/mantenimiento' },
];

const faqs = [
  {
    q: '¿Qué está incluido en el mantenimiento mensual?',
    a: 'Actualizaciones de contenido y texto, corrección de errores, respaldo semanal, monitoreo de uptime, soporte técnico con respuesta en menos de 48 horas y revisión mensual de SEO. Los cambios mayores (nuevas secciones, funcionalidades nuevas) se cotizan aparte.',
  },
  {
    q: '¿Puedo cancelar en cualquier momento?',
    a: 'Sí. El mantenimiento funciona mes a mes, sin contratos de largo plazo. Solo se requiere aviso con 15 días de anticipación.',
  },
  {
    q: '¿Qué tan rápido responden a urgencias?',
    a: 'Para problemas críticos (sitio caído, error en formulario, problema de seguridad) la respuesta es en menos de 4 horas durante horario hábil. Cambios menores en menos de 48 horas.',
  },
  {
    q: '¿Puedo contratar mantenimiento para un sitio que no hiciste tú?',
    a: 'Depende. Necesito revisar el sitio primero para asegurarme de que puedo dar soporte efectivo. Los sitios construidos con Astro, WordPress moderno, Next.js o similares generalmente sí aplican.',
  },
  {
    q: '¿Incluye cambios en el diseño?',
    a: 'El plan estándar cubre cambios de contenido y texto. Cambios de diseño significativos o nuevas secciones se cotizan como proyecto adicional.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(({ q, a }) => ({
    '@type': 'Question',
    'name': q,
    'acceptedAnswer': { '@type': 'Answer', 'text': a },
  })),
};
---

<BaseLayout
  title="Mantenimiento de Páginas Web en Zihuatanejo e Ixtapa"
  description="Mantenimiento mensual de sitios web para negocios en Zihuatanejo. Actualizaciones, soporte técnico, respaldo y monitoreo. Desde $700 MXN/mes — AntonyDev."
  schema={faqSchema}
  breadcrumbs={breadcrumbs}
>
  <Header />
  <main>

    <section class="page-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Navegación">
          <a href="/">Inicio</a><span aria-hidden="true">/</span>
          <a href="/servicios">Servicios</a><span aria-hidden="true">/</span>
          <span aria-current="page">Mantenimiento</span>
        </nav>
        <p class="phase-badge">Fase 3</p>
        <PageHeading text="Mantenimiento de páginas web" client:load />
        <p class="page-lead">
          Tu sitio web necesita atención mensual para seguir siendo efectivo.
          Me encargo de que todo funcione, se mantenga actualizado y siga posicionando en Google.
        </p>
        <div class="hero-cta-row">
          <p class="price-badge">Desde $700 MXN/mes</p>
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="wa-btn">
            <WhatsAppIcon />
            Contratar mantenimiento
          </a>
        </div>
      </div>
    </section>

    <section class="content-section">
      <div class="container content-grid">
        <div class="content-body">
          <h2>¿Por qué tu sitio necesita mantenimiento mensual?</h2>
          <p>
            Un sitio web no es un proyecto que termina cuando se publica.
            Las tecnologías se actualizan, el contenido envejece, los formularios
            fallan, y Google penaliza a los sitios que no se mantienen activos.
          </p>
          <p>
            Los negocios en Zihuatanejo e Ixtapa que mantienen su sitio actualizado
            y activo tienen una ventaja real sobre la competencia que dejó su sitio
            abandonado hace años.
          </p>

          <h2>¿Qué incluye el plan mensual?</h2>
          <ul class="includes-list">
            <li>Actualizaciones de contenido — textos, precios, horarios, fotos</li>
            <li>Corrección de errores y bugs reportados</li>
            <li>Respaldo semanal del sitio completo</li>
            <li>Monitoreo de uptime — aviso inmediato si el sitio cae</li>
            <li>Revisión mensual de SEO — posicionamiento en Google</li>
            <li>Soporte técnico con respuesta en menos de 48 horas</li>
            <li>Reporte mensual de visitas y rendimiento</li>
          </ul>

          <h2>¿Qué NO incluye?</h2>
          <p>
            El mantenimiento estándar no cubre cambios de diseño significativos,
            nuevas secciones completas, integraciones nuevas (pagos, reservas, etc.)
            ni rediseño del sitio. Estos se cotizan como proyectos adicionales.
          </p>

          <h2>Soporte técnico para Zihuatanejo e Ixtapa</h2>
          <p>
            Tengo disponibilidad en horario de Guerrero (UTC-6) y puedo atender
            reuniones presenciales en Zihuatanejo o Ixtapa si el proyecto lo requiere.
            La mayoría del soporte es remoto vía WhatsApp o videollamada.
          </p>
        </div>

        <aside class="sidebar">
          <div class="sidebar-card">
            <h3>Plan mensual</h3>
            <dl class="sidebar-dl">
              <dt>Precio</dt>
              <dd>Desde $700 MXN/mes</dd>
              <dt>Respuesta</dt>
              <dd>Máx 48 h (urgencias: 4 h)</dd>
              <dt>Contrato</dt>
              <dd>Mes a mes, sin compromisos</dd>
              <dt>Respaldo</dt>
              <dd>Semanal automático</dd>
            </dl>
            <a href={waLink} target="_blank" rel="noopener noreferrer" class="sidebar-cta">
              Cotizar mantenimiento
            </a>
          </div>
          <div class="sidebar-related">
            <p class="related-label">Servicios relacionados</p>
            <a href="/servicios/creacion" class="related-link">← Creación de sistemas</a>
            <a href="/servicios/automatizacion" class="related-link">Automatización →</a>
          </div>
        </aside>
      </div>
    </section>

    <section class="faq-section">
      <div class="container">
        <h2>Preguntas frecuentes sobre mantenimiento web</h2>
        <dl class="faq-list">
          {faqs.map(({ q, a }) => (
            <div class="faq-item">
              <dt class="faq-q">{q}</dt>
              <dd class="faq-a">{a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
